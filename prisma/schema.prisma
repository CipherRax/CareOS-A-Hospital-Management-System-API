generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// ---------------------------------------------------------------------------
// IDs
//
// All primary keys are UUIDv7 (time-ordered) generated in application code via
// `newId()`. Prisma does not assign defaults; every create passes an explicit
// id. Sequential database ids are never exposed as business identifiers.
// ---------------------------------------------------------------------------

enum OrgStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
  DEAD
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  REJECTED
}

// ---------------------------------------------------------------------------
// Tenant root. Row-level tenancy: every tenant-owned table carries
// organizationId and foreign keys to Organization.
// ---------------------------------------------------------------------------
model Organization {
  id   String @id
  name String

  legalName          String?
  tradingName        String?
  registrationNumber String?
  kraPin             String?
  phone              String?
  email              String?
  website            String?
  logoUrl            String?
  address            String?
  county             String?
  town               String?

  status    OrgStatus @default(ACTIVE)
  currency  String    @default("KES")
  timezone  String    @default("Africa/Nairobi")
  country   String    @default("KE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  outboxEvents         OutboxEvent[]
  auditLogs            AuditLog[]
  idempotencyRecords   IdempotencyRecord[]
  processedEvents      ProcessedEvent[]
  counters             Counter[]
  branches             Branch[]
  departments          Department[]
  users                User[]
  roles                Role[]
  sessions             Session[]
  refreshTokens        RefreshToken[]
  staffProfiles        StaffProfile[]
  userBranchLinks      UserBranch[]
  userDepartmentLinks  UserDepartment[]
  userRoleLinks        UserRole[]
  mfaCredentials       MfaCredential[]
  mfaRecoveryCodes     MfaRecoveryCode[]
  breakGlassGrants     BreakGlassGrant[]
  documents            Document[]
  patients             Patient[]
  guardians            Guardian[]
  patientGuardianLinks PatientGuardian[]
  consents             PatientConsent[]
  allergies            Allergy[]
  medicalHistory       MedicalHistoryEntry[]
  patientAccessLogs    PatientAccessLog[]
  patientTimelines     PatientTimelineEntry[]

  organizationSettings OrganizationSetting[]
  providerSchedules    ProviderSchedule[]
  scheduleOverrides    ScheduleOverride[]
  appointments         Appointment[]
  waitlistEntries      WaitlistEntry[]
  visits               Visit[]
  queueEntries         QueueEntry[]
  vitalRecords         VitalRecord[]
  displayDevices       DisplayDevice[]

  encounters            Encounter[]
  clinicalNotes         ClinicalNote[]
  clinicalNoteTemplates ClinicalNoteTemplate[]
  diagnoses             Diagnosis[]
  codingSystems         CodingSystem[]
  codeConcepts          CodeConcept[]
  followUps             FollowUp[]
  referrals             Referral[]
  tasks                 Task[]
  workflows             Workflow[]
  workflowTransitions   WorkflowTransition[]
  clinicalNoteVersions  ClinicalNoteVersion[]

  medications            Medication[]
  suppliers              Supplier[]
  stockBatches           StockBatch[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  purchaseOrders         PurchaseOrder[]
  purchaseOrderItems     PurchaseOrderItem[]
  stockTransfers         StockTransfer[]
  stockTransferItems     StockTransferItem[]
  stockCounts            StockCount[]
  stockCountItems        StockCountItem[]
  prescriptions          Prescription[]
  prescriptionItems      PrescriptionItem[]

  billableItems            BillableItem[]
  invoices                 Invoice[]
  invoiceItems             InvoiceItem[]
  payments                 Payment[]
  insurancePayers          InsurancePayer[]
  patientInsurancePolicies PatientInsurancePolicy[]
  insuranceClaims          InsuranceClaim[]

  labTestCategories LabTestCategory[]
  labTests          LabTest[]
  labTestFields     LabTestField[]
  labOrders         LabOrder[]
  labOrderItems     LabOrderItem[]
  labSamples        LabSample[]
  labResults        LabResult[]
  labResultVersions LabResultVersion[]
  criticalResults   CriticalResult[]
  radiologyOrders   RadiologyOrder[]
  imagingReports    ImagingReport[]
  wards             Ward[]
  rooms             Room[]
  beds              Bed[]
  bedAssignments    BedAssignment[]
  admissions        Admission[]
  discharges        Discharge[]
  emergencyVisits   EmergencyVisit[]

  notifications            Notification[]
  notificationTemplates    NotificationTemplate[]
  notificationPreferences  NotificationPreference[]
  conversations            Conversation[]
  conversationParticipants ConversationParticipant[]
  conversationMessages     ConversationMessage[]
  virtualSessions          VirtualSession[]
  feedback                 Feedback[]
  complaints               Complaint[]
  incidents                Incident[]

  // Financial ledger + M-PESA (repo Phase 11).
  chartAccounts               ChartAccount[]
  financialPeriods            FinancialPeriod[]
  financeTransactions         FinanceTransaction[]
  financeTransactionLines     FinanceTransactionLine[]
  ledgerPostingExceptions     LedgerPostingException[]
  mpesaRequests               MpesaRequest[]
  mpesaReconciliationRuns     MpesaReconciliationRun[]
  mpesaReconciliationMatches  MpesaReconciliationMatch[]

  // Operations (brief Phase 10, repo Phase 12).
  expenses            Expense[]
  assets              Asset[]
  maintenanceRecords  MaintenanceRecord[]
  maintenanceReminders MaintenanceReminder[]
}

// ---------------------------------------------------------------------------
// Transactional outbox. Business rows and OutboxEvent rows are written in the
// same DB transaction via TxRunner. The worker publishes eligible events with
// FOR UPDATE SKIP LOCKED and dispatches via BullMQ.
// ---------------------------------------------------------------------------
model OutboxEvent {
  id             String       @id
  organizationId String
  type           String
  version        Int          @default(1)
  status         OutboxStatus @default(PENDING)
  aggregateType  String
  aggregateId    String
  occurredAt     DateTime     @default(now())
  actorId        String?
  correlationId  String?
  payload        Json // minimal: IDs only, never PHI
  attemptCount   Int          @default(0)
  lastError      String?
  nextAttemptAt  DateTime?
  publishedAt    DateTime?
  deadAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@map("outbox_events")
}

// Consumer idempotency — a consumer may process a given event exactly once.
model ProcessedEvent {
  id             String   @id
  organizationId String
  consumer       String
  eventId        String
  consumedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, consumer, eventId])
  @@index([organizationId, consumedAt])
  @@map("processed_events")
}

// Append-only audit trail. Deletion/update is blocked at the DB level by a
// trigger; the application exposes no update/delete path.
model AuditLog {
  id             String  @id
  organizationId String
  branchId       String?
  userId         String?
  action         String
  resource       String
  resourceId     String?
  ip             String?
  userAgent      String?
  requestId      String?
  reason         String?
  previousState  Json?
  newState       Json?
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, resource, resourceId, createdAt])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// Idempotency: unique per (organizationId, scopeKey, idempotencyKey). Same key
// + same payload replays the stored response; same key + different payload is
// rejected with IDEMPOTENCY_KEY_REUSED.
model IdempotencyRecord {
  id             String            @id
  organizationId String
  scopeKey       String
  idempotencyKey String
  requestHash    String
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  requestBody    Json?
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, scopeKey, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// Organization-scoped locked counters (patient/invoice/sample number series).
// Rows are updated under `SELECT ... FOR UPDATE`; never derived from DB ids.
model Counter {
  id             String @id
  organizationId String
  key            String
  value          BigInt @default(0)

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("counters")
}

// ---------------------------------------------------------------------------
// Identity & access (Phase 1)
// ---------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum DepartmentKind {
  STANDARD
  CUSTOM
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  CONTRACT
}

enum BreakGlassStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
}

model Branch {
  id             String       @id
  organizationId String
  name           String
  code           String
  address        String?
  phone          String?
  email          String?
  operatingHours String?
  status         BranchStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userLinks    UserBranch[]

  providerSchedules ProviderSchedule[]
  scheduleOverrides ScheduleOverride[]
  appointments      Appointment[]
  waitlistEntries   WaitlistEntry[]
  visits            Visit[]
  queueEntries      QueueEntry[]
  displayDevices    DisplayDevice[]
  encounters        Encounter[]

  stockBatches           StockBatch[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  purchaseOrders         PurchaseOrder[]
  stockTransfersFrom     StockTransfer[]        @relation("TransferFromBranch")
  stockTransfersTo       StockTransfer[]        @relation("TransferToBranch")
  stockCounts            StockCount[]
  prescriptions          Prescription[]

  billableItems   BillableItem[]
  invoices        Invoice[]
  labOrders       LabOrder[]
  labSamples      LabSample[]
  radiologyOrders RadiologyOrder[]
  mpesaRequests   MpesaRequest[]

  wards           Ward[]
  admissions      Admission[]
  emergencyVisits EmergencyVisit[]
  virtualSessions VirtualSession[]

  expenses Expense[]
  assets   Asset[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model Department {
  id             String         @id
  organizationId String
  name           String
  code           String?
  kind           DepartmentKind @default(STANDARD)
  active         Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userDepartmentLinks UserDepartment[]

  providerSchedules ProviderSchedule[]
  scheduleOverrides ScheduleOverride[]
  appointments      Appointment[]
  waitlistEntries   WaitlistEntry[]
  visits            Visit[]
  queueEntries      QueueEntry[]
  encounters        Encounter[]

  expenses Expense[]
  assets   Asset[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model User {
  id                String     @id
  organizationId    String
  email             String
  phone             String?
  firstName         String
  lastName          String
  otherNames        String?
  passwordHash      String?
  status            UserStatus @default(INVITED)
  lastLoginAt       DateTime?
  loginFailureCount Int        @default(0)
  lockedUntil       DateTime?

  inviteTokenHash             String?
  inviteTokenExpiresAt        DateTime?
  passwordResetTokenHash      String?
  passwordResetTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  staffProfile     StaffProfile?
  userBranches     UserBranch[]
  userDepartments  UserDepartment[]
  userRoles        UserRole[]
  sessions         Session[]
  mfaCredential    MfaCredential?
  mfaRecoveryCodes MfaRecoveryCode[]
  breakGlassGrants BreakGlassGrant[]
  documents        Document[]

  providerSchedules     ProviderSchedule[] @relation("ScheduleProvider")
  scheduleOverrides     ScheduleOverride[] @relation("ScheduleOverrideProvider")
  appointmentsProvided  Appointment[]      @relation("AppointmentProvider")
  appointmentsCreatedBy Appointment[]      @relation("AppointmentCreatedBy")
  visitsRegistered      Visit[]            @relation("VisitRegisteredBy")
  vitalRecordsRecorded  VitalRecord[]      @relation("VitalRecordedBy")

  encountersProvided    Encounter[]           @relation("EncounterProvider")
  encountersOpenedBy    Encounter[]           @relation("EncounterOpenedBy")
  clinicalNotesAuthored ClinicalNote[]        @relation("ClinicalNoteAuthor")
  noteVersionsAuthored  ClinicalNoteVersion[] @relation("ClinicalNoteVersionAuthor")
  diagnosesProvided     Diagnosis[]           @relation("DiagnosisProvider")
  followUpsCreated      FollowUp[]            @relation("FollowUpCreatedBy")
  referralsFrom         Referral[]            @relation("ReferralFromProvider")
  tasksAssignedBy       Task[]                @relation("TaskCreatedBy")
  prescriptionsProvided Prescription[]        @relation("PrescriptionProvider")

  bedAssignmentsAssignedBy BedAssignment[] @relation("BedAssignedBy")
  bedAssignmentsReleasedBy BedAssignment[] @relation("BedReleasedBy")
  admissionsAdmittedBy     Admission[]     @relation("AdmissionAdmittedBy")
  dischargesDischargedBy   Discharge[]     @relation("DischargeDischargedBy")

  notificationTemplatesEdited NotificationTemplate[]    @relation("NotificationTemplateEditor")
  notificationsReceived       Notification[]            @relation("NotificationRecipientUser")
  notificationPreferences     NotificationPreference[]  @relation("NotificationPreferenceUser")
  conversationsStarted        Conversation[]            @relation("ConversationStarter")
  conversationParticipants    ConversationParticipant[]
  conversationMessagesSent    ConversationMessage[]     @relation("ConversationMessageSender")
  virtualSessionsProvided     VirtualSession[]          @relation("VirtualSessionProvider")
  virtualSessionsCancelled    VirtualSession[]          @relation("VirtualSessionCanceller")
  feedbackSubmitted           Feedback[]                @relation("FeedbackSubmitter")
  feedbackHandled             Feedback[]                @relation("FeedbackHandler")
  complaintsSubmitted         Complaint[]               @relation("ComplaintSubmitter")
  complaintsAssigned          Complaint[]               @relation("ComplaintAssignee")
  complaintsClosed            Complaint[]               @relation("ComplaintCloser")
  incidentsReported           Incident[]                @relation("IncidentReporter")
  incidentsResolved           Incident[]                @relation("IncidentResolver")
  incidentsClosed             Incident[]                @relation("IncidentCloser")

  periodsOpened             FinancialPeriod[]           @relation("OpenedPeriod")
  periodsClosed             FinancialPeriod[]           @relation("ClosedPeriod")
  periodsLocked             FinancialPeriod[]           @relation("LockedPeriod")
  journalsPosted            FinanceTransaction[]        @relation("PostedJournal")
  journalsReversed          FinanceTransaction[]        @relation("ReversedJournal")
  mpesaRequestsInitiated    MpesaRequest[]
  mpesaReconciliationRuns   MpesaReconciliationRun[]
  mpesaMatchesResolved      MpesaReconciliationMatch[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model StaffProfile {
  id                String           @id
  organizationId    String
  userId            String           @unique
  staffNumber       String
  professionalTitle String?
  specialization    String?
  employmentStatus  EmploymentStatus @default(ACTIVE)
  availability      Boolean          @default(true)
  // Professional license / registration identifier (treated as sensitive; field
  // encryption lands later — see docs/limitations.md).
  licenseNumber     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, staffNumber])
  @@index([organizationId])
  @@map("staff_profiles")
}

// A user may belong to several branches; branch access is a permission, not a default.
model UserBranch {
  id             String @id
  organizationId String
  userId         String
  branchId       String

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, branchId])
  @@index([organizationId, branchId])
  @@map("user_branches")
}

model UserDepartment {
  id             String @id
  organizationId String
  userId         String
  departmentId   String

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, departmentId])
  @@index([organizationId, departmentId])
  @@map("user_departments")
}

// Interactive sessions. Access is short-lived (JWT); refresh tokens rotate. A
// rotated (reused) refresh token revokes the whole family (suspectedReuse).
model Session {
  id             String    @id
  organizationId String
  userId         String
  familyId       String    @unique
  ip             String?
  userAgent      String?
  lastSeenAt     DateTime  @default(now())
  lastSeenIp     String?
  mfaVerifiedAt  DateTime?
  refreshCount   Int       @default(0)
  suspectedReuse Boolean   @default(false)
  suspendedAt    DateTime?
  revokedAt      DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([organizationId, userId])
  @@index([organizationId, userId, expiresAt])
  @@map("sessions")
}

// Refresh token rows. tokenHash is unique; on use the presented token is either
// the current one (rotate) or a rotated one (reuse → revoke family).
model RefreshToken {
  id             String    @id
  organizationId String
  sessionId      String
  familyId       String
  tokenHash      String    @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  replacedById   String?
  rotatesFromId  String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([organizationId, sessionId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Roles are org data seeded from a default matrix; permissions are granular
// strings from the typed catalog. System roles are protected from edit/delete.
model Role {
  id             String   @id
  organizationId String
  name           String
  key            String
  description    String?
  isSystem       Boolean  @default(false)
  permissions    String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles    UserRole[]

  @@unique([organizationId, key])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model UserRole {
  id             String @id
  organizationId String
  userId         String
  roleId         String

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, roleId])
  @@index([organizationId, roleId])
  @@map("user_roles")
}

// Optional MFA (TOTP). The shared secret is stored AES-256-GCM encrypted;
// recovery codes are stored hashed (SHA-256) and handed out once at enrolment.
model MfaCredential {
  id              String    @id
  organizationId  String
  userId          String    @unique
  secretEncrypted String
  enabledAt       DateTime  @default(now())
  lastVerifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("mfa_credentials")
}

model MfaRecoveryCode {
  id             String    @id
  organizationId String
  userId         String
  codeHash       String    @unique
  usedAt         DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@map("mfa_recovery_codes")
}

// Break-glass / emergency access skeleton (Phase 1). Time-boxed grant with a
// mandatory reason; always audited. Enforcement against resource policies lands
// with the patient module (Phase 2).
model BreakGlassGrant {
  id              String           @id
  organizationId  String
  requesterUserId String
  resourceType    String
  resourceId      String
  reason          String
  status          BreakGlassStatus @default(ACTIVE)
  metadata        Json?

  grantedAt       DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  revokedByUserId String?
  revokeReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requester    User         @relation(fields: [requesterUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, requesterUserId])
  @@map("break_glass_grants")
}

// ---------------------------------------------------------------------------
// Object storage (Phase 2). `Document` is the metadata row for a file stored in
// S3/MinIO. The API never receives the binary; clients upload directly to a
// short-lived presigned PUT URL and confirm via `complete`. Downloads ride the
// presigned GET URL. Storage keys are namespaced per organization so buckets
// never mix tenants.
// ---------------------------------------------------------------------------
enum DocumentStatus {
  PENDING_UPLOAD
  UPLOADED
  DELETED
}

model Document {
  id               String         @id
  organizationId   String
  uploadedByUserId String
  fileName         String
  contentType      String
  sizeBytes        Int?
  checksumSha256   String?
  storageKey       String
  status           DocumentStatus @default(PENDING_UPLOAD)
  metadata         Json?

  uploadedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploadedBy         User                  @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  messageAttachments ConversationMessage[]

  @@unique([organizationId, storageKey])
  @@index([organizationId, status, createdAt])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Patients (brief Phase 2). Master patient record, guardians, consents,
// allergies, medical history, access logging and a permission-filtered
// timeline. Patient numbers come from the org-scoped Counter (PAT-YYYY-NNNNNN).
// ---------------------------------------------------------------------------

enum PatientStatus {
  ACTIVE
  MERGED
  ARCHIVED
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum GuardianRelationship {
  PARENT
  SPOUSE
  SIBLING
  RELATIVE
  LEGAL_GUARDIAN
  OTHER
}

enum ConsentType {
  DATA_PROCESSING
  COMMUNICATIONS
  TELEMEDICINE
  DATA_SHARING
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum AllergyStatus {
  ACTIVE
  RESOLVED
  AMENDED
}

enum MedicalHistoryCategory {
  PAST_MEDICAL
  SURGICAL
  FAMILY
  SOCIAL
  PREVIOUS_CONDITIONS
}

enum PatientAccessAction {
  READ
  EXPORT
}

model Patient {
  id             String    @id
  organizationId String
  patientNumber  String
  firstName      String
  lastName       String
  otherNames     String?
  dateOfBirth    DateTime?
  sex            Sex?
  phone          String?
  email          String?
  address        String?
  county         String?
  town           String?
  photoUrl       String?

  // Duplicate handling: set when the creator confirms the record (or a merge
  // reviewer confirms it) is a known duplicate despite a flag. History is kept
  // via audit + timeline; the row itself is never silently deleted.
  duplicateConfirmedAt   DateTime?
  duplicateConfirmedBy   String?
  duplicateConfirmReason String?

  // Reversible-by-design merge: the superseded patient is kept as MEDGED with
  // a pointer to the surviving record instead of being deleted.
  status              PatientStatus @default(ACTIVE)
  mergedIntoPatientId String?
  mergedAt            DateTime?
  mergedReason        String?

  // Optimistic concurrency for record edits.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  guardianLinks        PatientGuardian[]
  consents             PatientConsent[]
  allergies            Allergy[]
  medicalHistory       MedicalHistoryEntry[]
  accessLogs           PatientAccessLog[]
  timeline             PatientTimelineEntry[]
  mergedIntoPatient    Patient?               @relation("PatientMerge", fields: [mergedIntoPatientId], references: [id])
  mergedSourcePatients Patient[]              @relation("PatientMerge")

  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]
  visits          Visit[]
  queueEntries    QueueEntry[]
  vitalRecords    VitalRecord[]

  encounters    Encounter[]
  clinicalNotes ClinicalNote[]
  diagnoses     Diagnosis[]
  followUps     FollowUp[]
  referrals     Referral[]

  prescriptions Prescription[]

  invoices          Invoice[]
  payments          Payment[]
  insurancePolicies PatientInsurancePolicy[]
  insuranceClaims   InsuranceClaim[]
  mpesaRequests     MpesaRequest[]

  labOrders       LabOrder[]
  labSamples      LabSample[]
  radiologyOrders RadiologyOrder[]

  admissions      Admission[]
  emergencyVisits EmergencyVisit[]

  notificationsReceived   Notification[]           @relation("NotificationRecipientPatient")
  notificationPreferences NotificationPreference[] @relation("NotificationPreferencePatient")
  conversations           Conversation[]
  virtualSessions         VirtualSession[]
  feedback                Feedback[]
  complaints              Complaint[]

  @@unique([organizationId, patientNumber])
  @@index([organizationId, lastName, firstName, dateOfBirth])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@map("patients")
}

model Guardian {
  id             String  @id
  organizationId String
  firstName      String
  lastName       String
  phone          String?
  email          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patientLinks PatientGuardian[]

  @@unique([organizationId, phone])
  @@index([organizationId, lastName])
  @@map("guardians")
}

model PatientGuardian {
  id                 String               @id
  organizationId     String
  patientId          String
  guardianId         String
  relationship       GuardianRelationship
  isPrimary          Boolean              @default(false)
  isEmergencyContact Boolean              @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  guardian     Guardian     @relation(fields: [guardianId], references: [id], onDelete: Restrict)

  @@unique([organizationId, patientId, guardianId])
  @@index([organizationId, patientId])
  @@map("patient_guardians")
}

// One consent row per (patient, type); grant/withdraw toggles status. History
// is preserved as timeline entries + audit rows (append-only).
model PatientConsent {
  id               String        @id
  organizationId   String
  patientId        String
  type             ConsentType
  status           ConsentStatus @default(GRANTED)
  grantedAt        DateTime      @default(now())
  withdrawnAt      DateTime?
  notes            String?
  recordedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([organizationId, patientId, type])
  @@index([organizationId, patientId])
  @@map("patient_consents")
}

// Allergies are never silently deleted: amending records a correction (a new
// row whose correctedById points at the superseded one, which flips to AMENDED)
// and resolution flips status to RESOLVED. History is preserved.
model Allergy {
  id               String          @id
  organizationId   String
  patientId        String
  substance        String
  reaction         String?
  severity         AllergySeverity
  status           AllergyStatus   @default(ACTIVE)
  notes            String?
  recordedByUserId String?
  correctedById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([organizationId, patientId])
  @@map("allergies")
}

// Append-only medical history. Corrections are new entries; existing rows are
// never updated or deleted (exposed API provides only create + list).
model MedicalHistoryEntry {
  id               String                 @id
  organizationId   String
  patientId        String
  category         MedicalHistoryCategory
  description      String
  onsetDate        DateTime?
  notes            String?
  recordedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([organizationId, patientId, createdAt])
  @@map("medical_history_entries")
}

// Access log of patient-record reads. Identifiers only, no PHI: who read which
// section of which record when, plus request metadata.
model PatientAccessLog {
  id             String              @id
  organizationId String
  patientId      String
  userId         String?
  action         PatientAccessAction @default(READ)
  section        String
  reason         String?
  ip             String?
  userAgent      String?
  requestId      String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([organizationId, patientId, createdAt])
  @@map("patient_access_logs")
}

// View-projections of the patient timeline. Entries are written in the same
// transaction as the business rows OR fan out to outbox consumers that project
// them idempotently (see ADR). Each entry carries the permission required to
// read it; reads filter by the caller's permission set. `sourceEventId` pins an
// event-driven entry to its outbox event so consumer replays dedupe (NULL for
// inline entries; Postgres allows multiple NULLs in a unique index).
model PatientTimelineEntry {
  id                 String   @id
  organizationId     String
  patientId          String
  type               String
  title              String
  requiredPermission String
  actorId            String?
  payload            Json?
  sourceEventId      String?
  occurredAt         DateTime @default(now())

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([organizationId, sourceEventId])
  @@index([organizationId, patientId, occurredAt])
  @@map("patient_timeline_entries")
}

// ---------------------------------------------------------------------------
// Scheduling & patient flow (brief Phase 3). Provider schedules and per-day
// overrides feed computed slots; appointments are booked under an advisory
// lock (no double booking); waitlist offers; queue + per-day ticket numbers;
// the visit journey state; append-only vital records; display devices.
// ---------------------------------------------------------------------------

// Single typed settings row per organization (JSON). Read by a typed helper;
// appointments/waitlist only today — extended by later phases.
model OrganizationSetting {
  id             String @id
  organizationId String
  data           Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId])
  @@map("organization_settings")
}

// Recurring weekly availability template for a provider in a branch/department.
// A provider may have several rows per day (morning + evening blocks). Rows
// with isAvailable=false are standing blocked windows (e.g. weekly meetings).
model ProviderSchedule {
  id                  String  @id
  organizationId      String
  providerId          String
  branchId            String
  departmentId        String
  // 0=MONDAY .. 6=SUNDAY (matches the domain helper, not JS's getDay()).
  dayOfWeek           Int
  startMinutes        Int
  endMinutes          Int
  slotDurationMinutes Int
  capacity            Int     @default(1)
  isAvailable         Boolean @default(true)
  note                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  provider     User         @relation("ScheduleProvider", fields: [providerId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([organizationId, providerId, dayOfWeek])
  @@index([organizationId, providerId, branchId, departmentId])
  @@map("provider_schedules")
}

// Per-date exceptions. LEAVE/HOLIDAY/BLOCKED make the whole day unavailable
// regardless of the weekly template; WORKING rows replace the template for
// that date with explicit windows.
enum ScheduleOverrideType {
  WORKING
  LEAVE
  HOLIDAY
  BLOCKED
}

model ScheduleOverride {
  id                  String               @id
  organizationId      String
  providerId          String
  branchId            String
  departmentId        String
  date                DateTime // business date (UTC midnight)
  type                ScheduleOverrideType
  startMinutes        Int?
  endMinutes          Int?
  slotDurationMinutes Int?
  capacity            Int?
  note                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  provider     User         @relation("ScheduleOverrideProvider", fields: [providerId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([organizationId, providerId, date])
  @@map("schedule_overrides")
}

enum AppointmentMode {
  IN_PERSON
  VIRTUAL
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

// Appointments. No DB unique on (provider, startsAt): capacity-aware booking
// is serialized with a Postgres advisory transaction lock keyed to
// (org, provider, slot start) and then counted under the lock. Free slots are
// computed; bookings never double-allocate the same slot (see domain + tests).
model Appointment {
  id              String            @id
  organizationId  String
  branchId        String
  departmentId    String
  patientId       String
  providerId      String
  startsAt        DateTime
  endsAt          DateTime
  mode            AppointmentMode   @default(IN_PERSON)
  appointmentType String?
  reason          String?
  status          AppointmentStatus @default(BOOKED)

  // Optimistic concurrency for reschedules/cancels (delete is never used).
  version Int @default(0)

  createdById       String
  cancelledAt       DateTime?
  cancelReason      String?
  cancelledById     String?
  noShowAt          DateTime?
  checkedInAt       DateTime?
  inProgressAt      DateTime?
  completedAt       DateTime?
  rescheduledToId   String?
  rescheduledFromId String?
  rescheduledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  provider        User             @relation("AppointmentProvider", fields: [providerId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  virtualSessions VirtualSession[]

  @@index([organizationId, branchId, startsAt])
  @@index([organizationId, patientId, startsAt])
  @@index([organizationId, providerId, startsAt, status])
  @@map("appointments")
}

model VirtualSession {
  id               String               @id
  organizationId   String
  branchId         String
  appointmentId    String?
  patientId        String
  providerId       String
  status           VirtualSessionStatus @default(SCHEDULED)
  consentRecorded  Boolean              @default(false)
  consentId        String?
  meetingRef       String?
  scheduledStartAt DateTime
  scheduledEndAt   DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  cancelledById    String?
  cancelledAt      DateTime?
  cancelReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  provider     User         @relation("VirtualSessionProvider", fields: [providerId], references: [id], onDelete: Restrict)
  cancelledBy  User?        @relation("VirtualSessionCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([organizationId, branchId, status, scheduledStartAt])
  @@index([organizationId, patientId, scheduledStartAt])
  @@map("virtual_sessions")
}

enum WaitlistStatus {
  WAITING
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  REMOVED
}

model WaitlistEntry {
  id             String         @id
  organizationId String
  branchId       String
  departmentId   String
  patientId      String
  providerId     String?
  preferredDate  DateTime?
  status         WaitlistStatus @default(WAITING)
  notes          String?

  // Offer details: the concrete slot offered and its expiry. Accept creates an
  // appointment at offeredStartAt; decline/expiry may offer the next entrant.
  offeredAt             DateTime?
  offerExpiresAt        DateTime?
  offeredStartAt        DateTime?
  acceptedAppointmentId String?
  resolvedAt            DateTime?
  resolvedById          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([organizationId, departmentId, status])
  @@index([organizationId, patientId])
  @@map("waitlist_entries")
}

enum VisitSource {
  WALK_IN
  APPOINTMENT
  EMERGENCY
}

// Journey state: the patient's movement through a visit
// (REGISTERED, CHECKED_IN, WAITING, TRIAGE, WAITING_FOR_PROVIDER, CONSULTATION,
//  LAB, RADIOLOGY, PHARMACY, BILLING, COMPLETED). One visit per queue loop.
enum VisitStatus {
  REGISTERED
  CHECKED_IN
  WAITING
  TRIAGE
  WAITING_FOR_PROVIDER
  CONSULTATION
  LAB
  RADIOLOGY
  PHARMACY
  BILLING
  COMPLETED
}

model Visit {
  id             String      @id
  organizationId String
  branchId       String
  departmentId   String
  patientId      String
  appointmentId  String?
  source         VisitSource @default(WALK_IN)
  status         VisitStatus @default(CHECKED_IN)

  // currentQueueEntryId is a plain (non-FK) pointer to the visit's live queue
  // row; it is cleared when the entry completes/leaves.
  currentQueueEntryId String?

  registeredById    String?
  registeredAt      DateTime  @default(now())
  checkedInAt       DateTime?
  triageAt          DateTime?
  providerStartedAt DateTime?
  completedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  registeredBy User?        @relation("VisitRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  queueEntries QueueEntry[]

  @@index([organizationId, branchId, status])
  @@index([organizationId, patientId, createdAt])
  @@map("visits")
}

enum OperationalPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum QueueStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  NO_SHOW
  ABANDONED
  CANCELLED
  TRANSFERRED
}

// Queue entry with a per-(branch, department, business-day) ticket number
// (e.g. "A034"). Ticket sequences reset each business day. Timestamps drive
// the queue metrics and estimated-wait calculations.
model QueueEntry {
  id                  String              @id
  organizationId      String
  branchId            String
  departmentId        String
  visitId             String?
  patientId           String
  queueDate           DateTime // business date (UTC midnight)
  prefix              String // ticket letter prefix, e.g. "A"
  ticketNumber        String // full ticket, e.g. "A034"
  operationalPriority OperationalPriority @default(NORMAL)
  status              QueueStatus         @default(WAITING)

  enteredAt        DateTime  @default(now())
  note             String?
  calledAt         DateTime?
  serviceStartedAt DateTime?
  completedAt      DateTime?
  noShowAt         DateTime?

  calledByUserId    String?
  servedByUserId    String?
  transferredToId   String?
  transferredFromId String?
  transferReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit        Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@unique([organizationId, branchId, departmentId, queueDate, ticketNumber])
  @@index([organizationId, branchId, status, queueDate])
  @@index([organizationId, patientId, queueDate])
  @@map("queue_entries")
}

// Append-only vital observations. Corrections create a NEW record referencing
// the superseded one (correctionOfId); rows are never updated or deleted.
model VitalRecord {
  id             String  @id
  organizationId String
  branchId       String?
  departmentId   String?
  patientId      String
  visitId        String?

  temperatureC    Float?
  systolicMmHg    Int?
  diastolicMmHg   Int?
  pulseBpm        Int?
  respiratoryRate Int?
  spo2            Int?
  weightKg        Float?
  heightCm        Float?
  // BMI is always computed in code (domain/bmi.ts) from the same height/weight.
  bmi             Float?
  painScore       Int?
  notes           String?
  observedAt      DateTime

  correctionOfId   String?
  correctionReason String?
  recordedByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  recordedBy   User         @relation("VitalRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, patientId, observedAt])
  @@map("vital_records")
}

enum DisplayDeviceStatus {
  PENDING_PAIRING
  ACTIVE
  REVOKED
}

// Unattended waiting-room display. Pairing swaps a short-lived one-time code
// for a long-lived revocable device token; the token only ever grants
// `queue.display` for its own branch/departments (DeviceAuthGuard).
model DisplayDevice {
  id             String              @id
  organizationId String
  branchId       String
  name           String
  departmentIds  String[]
  status         DisplayDeviceStatus @default(PENDING_PAIRING)

  pairingCodeHash  String?
  pairingExpiresAt DateTime?
  tokenHash        String?
  tokenRotatedAt   DateTime?
  lastSeenAt       DateTime?
  createdByUserId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("display_devices")
}

// ---------------------------------------------------------------------------
// Clinical core (brief Phase 4). Encounters, versioned clinical notes +
// templates, coded diagnoses with importable reference data, problem lists,
// follow-ups, referrals, tasks and the workflow transition engine. All tables
// are tenant-owned; read-back of every entry is gated by `requiredPermission`
// on the timeline and by granular permissions in the controllers.
// ---------------------------------------------------------------------------

enum EncounterType {
  OUTPATIENT
  EMERGENCY
  FOLLOW_UP
  INPATIENT
  TELEMEDICINE
}

enum EncounterStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum ClinicalNoteStatus {
  DRAFT
  FINAL
}

enum ClinicalNoteVersionKind {
  ORIGINAL
  AMENDMENT
  NEW_VERSION
}

enum DiagnosisClassification {
  PRIMARY
  SECONDARY
  SUSPECTED
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
  HISTORICAL
  AMENDED
}

enum FollowUpStatus {
  SCHEDULED
  REMINDED
  COMPLETED
  MISSED
  CANCELLED
}

enum ReferralStatus {
  CREATED
  SENT
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// A consultation/visit in the clinical flow. A completed encounter is closed:
// new notes/diagnoses require an open encounter; corrections happen through
// addenda/amendments.
model Encounter {
  id             String          @id
  organizationId String
  branchId       String
  departmentId   String
  patientId      String
  providerId     String? // attending user; null while unassigned
  type           EncounterType   @default(OUTPATIENT)
  status         EncounterStatus @default(OPEN)
  // Plain forward-pointers (soft links) to the journey + booking, avoiding
  // circular FK graphs; visit/appointment status flows live in their modules.
  visitId        String?
  appointmentId  String?
  note           String?

  openedById   String
  openedAt     DateTime  @default(now())
  inProgressAt DateTime?
  completedAt  DateTime?

  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  provider     User?        @relation("EncounterProvider", fields: [providerId], references: [id], onDelete: SetNull)
  openedBy     User         @relation("EncounterOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)

  clinicalNotes ClinicalNote[]
  diagnoses     Diagnosis[]

  @@index([organizationId, patientId, createdAt])
  @@index([organizationId, branchId, status])
  @@index([organizationId, departmentId, status])
  @@map("encounters")
}

// Clinical note aggregate root. DRAFT notes are editable; finalizing locks the
// content and writes the ORIGINAL version. Any later change MUST go through the
// amendment path, which writes a superseding ClinicalNoteVersion and updates
// the note's working snapshot. Nothing in the clinical record is ever deleted.
model ClinicalNote {
  id             String             @id
  organizationId String
  patientId      String
  encounterId    String
  authorId       String
  status         ClinicalNoteStatus @default(DRAFT)
  title          String?
  // Structured sections (chief complaint, history, subjective, objective,
  // assessment, plan, instructions, follow-up) as a JSON object.
  sections       Json
  // Amendment reason for the latest amendment (NULL while DRAFT/ORIGINAL).
  reason         String?
  templateId     String?
  finalizedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter    @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  author       User         @relation("ClinicalNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  versions ClinicalNoteVersion[]

  @@index([organizationId, patientId, createdAt])
  @@index([organizationId, encounterId, status])
  @@map("clinical_notes")
}

// Append-only versions. Official wording from the brief: once a note is FINAL,
// edits create a new version (Original → Amendment → New Version). Each version
// stores the full snapshot so history is reconstructable; rows are never
// updated or deleted.
model ClinicalNoteVersion {
  id                  String                  @id
  organizationId      String
  noteId              String
  versionNumber       Int
  kind                ClinicalNoteVersionKind @default(ORIGINAL)
  title               String?
  sections            Json
  reason              String?
  authorId            String
  supersedesVersionId String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  note         ClinicalNote @relation(fields: [noteId], references: [id], onDelete: Restrict)
  author       User         @relation("ClinicalNoteVersionAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([organizationId, noteId, versionNumber])
  @@index([organizationId, noteId])
  @@map("clinical_note_versions")
}

// Org/department note templates: a fixed list of structured section keys the
// note form renders. Templates are additive; editing a template never rewrites
// existing notes (notes snapshot their sections at create/amend time).
model ClinicalNoteTemplate {
  id             String  @id
  organizationId String
  name           String
  description    String?
  departmentId   String?
  sections       Json
  isActive       Boolean @default(true)
  createdById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("clinical_note_templates")
}

// Coded diagnosis (problem list entry). Codes come ONLY from an imported
// CodingSystem→CodeConcept reference; free-text diagnoses are supported with
// codeConceptId NULL. The system never fabricates a code. Amendments/super-
// sessions create new rows pointing at the superseded one (AMENDED); the
// clinical entry is never deleted.
model Diagnosis {
  id             String                  @id
  organizationId String
  patientId      String
  encounterId    String?
  providerId     String
  classification DiagnosisClassification @default(PRIMARY)
  status         DiagnosisStatus         @default(ACTIVE)
  codeConceptId  String?
  code           String?
  codeSystemKey  String?
  description    String
  notes          String?
  onProblemList  Boolean                 @default(true)

  resolvedAt    DateTime?
  resolvedById  String?
  resolvedNotes String?
  version       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter?   @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  provider     User         @relation("DiagnosisProvider", fields: [providerId], references: [id], onDelete: Restrict)
  codeConcept  CodeConcept? @relation(fields: [codeConceptId], references: [id], onDelete: SetNull)

  @@index([organizationId, patientId, status])
  @@index([organizationId, encounterId])
  @@index([organizationId, codeConceptId])
  @@map("diagnoses")
}

// Importable coding reference data (CSV/JSON import; labelled DEMO_ONLY when
// seeded). Reference data is organisation-owned so tenants configure their own
// coding systems without cross-tenant leakage. Codes are never auto-generated.
model CodingSystem {
  id             String  @id
  organizationId String
  key            String
  name           String
  version        String?
  kind           String  @default("CUSTOM")
  source         String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  concepts     CodeConcept[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("coding_systems")
}

model CodeConcept {
  id             String  @id
  organizationId String
  systemId       String
  code           String
  display        String
  description    String?
  metadata       Json?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  system       CodingSystem @relation(fields: [systemId], references: [id], onDelete: Restrict)
  diagnoses    Diagnosis[]

  @@unique([organizationId, systemId, code])
  @@index([organizationId, systemId, isActive])
  @@index([organizationId, code])
  @@map("code_concepts")
}

// Follow-up / return appointment. Reminder jobs (REMINDED + reminder dispatch)
// land with the background jobs phase; the status machine is enforced here.
model FollowUp {
  id             String         @id
  organizationId String
  patientId      String
  encounterId    String?
  providerId     String?
  departmentId   String?
  dueAt          DateTime
  reason         String?
  instructions   String?
  status         FollowUpStatus @default(SCHEDULED)
  createdById    String

  remindedAt     DateTime?
  completedAt    DateTime?
  completedNotes String?
  missedAt       DateTime?
  cancelledAt    DateTime?
  cancelReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, patientId, status])
  @@index([organizationId, status, dueAt])
  @@map("follow_ups")
}

// Referral between providers / departments or out of the facility. Documents
// ride the storage module's Document references (ids only).
model Referral {
  id                String         @id
  organizationId    String
  patientId         String
  encounterId       String?
  fromProviderId    String
  toDepartmentId    String?
  toFacilityName    String?
  toFacilityAddress String?
  reason            String
  notes             String?
  documentIds       String[]
  status            ReferralStatus @default(CREATED)
  decidedById       String?

  sentAt       DateTime?
  acceptedAt   DateTime?
  rejectedAt   DateTime?
  rejectReason String?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  fromProvider User         @relation("ReferralFromProvider", fields: [fromProviderId], references: [id], onDelete: Restrict)

  @@index([organizationId, patientId, status])
  @@index([organizationId, status, createdAt])
  @@map("referrals")
}

// Assignable tasks for a patient/hospital flow. assignedUserId is a soft link
// (a task may be assigned to a role/department pool later; we never hard-FK it).
model Task {
  id             String       @id
  organizationId String
  title          String
  description    String?
  priority       TaskPriority @default(NORMAL)
  status         TaskStatus   @default(OPEN)
  assignedUserId String?
  patientId      String?
  encounterId    String?
  dueAt          DateTime?

  createdById  String
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, assignedUserId, status])
  @@index([organizationId, status, dueAt])
  @@index([organizationId, patientId])
  @@map("tasks")
}

// Workflow engine metadata. The safe core of transitions for each entity type
// is a code-owned map (see modules/workflows/domain/workflow-core.ts); orgs may
// ADD optional edges via WorkflowTransition but can never remove a built-in
// edge — the union is what is enforced centrally by every transition service.
model Workflow {
  id             String  @id
  organizationId String
  entityType     String
  name           String
  description    String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transitions  WorkflowTransition[]

  @@unique([organizationId, entityType])
  @@map("workflows")
}

// A custom (org-added) transition edge. Only additive: the effective allowed
// set = SYSTEM_TRANSITIONS ∪ custom rows, so mandatory gates can never be
// bypassed by configuration.
model WorkflowTransition {
  id             String  @id
  organizationId String
  workflowId     String
  fromStatus     String
  toStatus       String
  label          String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([organizationId, workflowId])
  @@map("workflow_transitions")
}

// ---------------------------------------------------------------------------
// Inventory & pharmacy (brief Phase 5). Money is never stored or computed in
// JS-floating point: every monetary field is a DECIMAL(12,2) and Prisma returns
// it as a decimal.js Decimal (string-serialized). See docs/decisions.md.
// ---------------------------------------------------------------------------

enum InventoryCategory {
  MEDICATION
  SUPPLY
}

enum BatchStatus {
  AVAILABLE
  QUARANTINED
  EXPIRED
}

enum LedgerOperation {
  RECEIVED
  DISPENSED
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN
  WASTAGE
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum StockTransferStatus {
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum StockCountStatus {
  OPEN
  APPLIED
  CANCELLED
}

enum PrescriptionStatus {
  DRAFT
  ISSUED
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

// Catalog item (medication or supply) a facility can stock and dispense.
model Medication {
  id             String            @id
  organizationId String
  category       InventoryCategory @default(MEDICATION)
  name           String
  genericName    String?
  strength       String?
  form           String?
  unit           String            @default("unit")
  sku            String?
  barcode        String?
  isControlled   Boolean           @default(false)
  isActive       Boolean           @default(true)
  version        Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  batches            StockBatch[]
  ledgerEntries      InventoryLedgerEntry[]
  purchaseOrderItems PurchaseOrderItem[]
  transferItems      StockTransferItem[]
  countItems         StockCountItem[]
  prescriptionItems  PrescriptionItem[]
  invoiceItems       InvoiceItem[]

  @@unique([organizationId, name, genericName, strength, form, unit])
  @@index([organizationId, isActive])
  @@map("medications")
}

// Vendor / distributor a facility buys from.
model Supplier {
  id             String  @id
  organizationId String
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  taxNumber      String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  batches        StockBatch[]
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("suppliers")
}

// A lot received into a branch. `onHand` is the fast cache; the inventory
// ledger is the source of truth (reconstruct = SUM(quantity) of all entries).
model StockBatch {
  id             String      @id
  organizationId String
  branchId       String
  medicationId   String
  supplierId     String?
  batchNumber    String
  expiryDate     DateTime?
  onHand         Int         @default(0)
  purchaseCost   Decimal?    @db.Decimal(12, 2)
  sellingPrice   Decimal?    @db.Decimal(12, 2)
  status         BatchStatus @default(AVAILABLE)
  receivedAt     DateTime    @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  medication   Medication   @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  ledgerEntries InventoryLedgerEntry[]
  transferItems StockTransferItem[]
  countItems    StockCountItem[]

  @@unique([organizationId, branchId, medicationId, batchNumber])
  @@index([organizationId, branchId, status, expiryDate])
  @@index([organizationId, medicationId, status])
  @@map("stock_batches")
}

// Append-only inventory journal. quantity is signed: + in, − out. A DB trigger
// blocks UPDATE/DELETE. onHand always reconstructs from SUM(quantity).
model InventoryLedgerEntry {
  id             String          @id
  organizationId String
  branchId       String
  medicationId   String
  batchId        String?
  operation      LedgerOperation
  quantity       Int
  unitCost       Decimal?        @db.Decimal(12, 2)
  // Soft link to the source document (PO, prescription, count, transfer).
  referenceType  String?
  referenceId    String?
  recordedById   String?
  occurredAt     DateTime        @default(now())

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  medication   Medication   @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  batch        StockBatch?  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([organizationId, medicationId, branchId, occurredAt])
  @@index([organizationId, batchId])
  @@index([organizationId, referenceType, referenceId])
  @@map("inventory_ledger_entries")
}

model PurchaseOrder {
  id             String              @id
  organizationId String
  branchId       String
  supplierId     String
  poNumber       String
  status         PurchaseOrderStatus @default(DRAFT)
  expectedAt     DateTime?
  notes          String?

  createdById   String
  submittedById String?
  approvedById  String?
  submittedAt   DateTime?
  approvedAt    DateTime?
  receivedAt    DateTime?
  closedAt      DateTime?
  version       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  items PurchaseOrderItem[]

  @@unique([organizationId, poNumber])
  @@index([organizationId, branchId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id
  organizationId   String
  purchaseOrderId  String
  medicationId     String
  quantityOrdered  Int
  quantityReceived Int      @default(0)
  unitCost         Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medication    Medication    @relation(fields: [medicationId], references: [id], onDelete: Restrict)

  @@index([organizationId, purchaseOrderId])
  @@map("purchase_order_items")
}

model StockTransfer {
  id             String              @id
  organizationId String
  fromBranchId   String
  toBranchId     String
  status         StockTransferStatus @default(REQUESTED)
  reason         String?
  requestedById  String
  approvedById   String?
  approvedAt     DateTime?
  inTransitAt    DateTime?
  receivedById   String?
  receivedAt     DateTime?
  cancelledById  String?
  cancelledAt    DateTime?
  cancelReason   String?
  version        Int                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fromBranch   Branch       @relation("TransferFromBranch", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch     Branch       @relation("TransferToBranch", fields: [toBranchId], references: [id], onDelete: Restrict)

  items StockTransferItem[]

  @@index([organizationId, fromBranchId, status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id             String  @id
  organizationId String
  transferId     String
  medicationId   String
  batchId        String?
  quantity       Int

  createdAt DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transfer     StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  medication   Medication    @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  batch        StockBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([organizationId, transferId])
  @@map("stock_transfer_items")
}

model StockCount {
  id             String           @id
  organizationId String
  branchId       String
  status         StockCountStatus @default(OPEN)
  notes          String?
  countedById    String
  appliedById    String?
  appliedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  items StockCountItem[]

  @@index([organizationId, branchId, status])
  @@map("stock_counts")
}

model StockCountItem {
  id              String  @id
  organizationId  String
  countId         String
  medicationId    String
  batchId         String?
  systemQuantity  Int
  countedQuantity Int

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  count        StockCount   @relation(fields: [countId], references: [id], onDelete: Cascade)
  medication   Medication   @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  batch        StockBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([organizationId, countId])
  @@map("stock_count_items")
}

// Prescription ordered by a provider and dispensed by pharmacy. Items are
// dispensed once; status walks DRAFT → ISSUED → (PARTIALLY_)DISPENSED; CANCELLED
// closes an ISSUED/partial prescription.
model Prescription {
  id             String             @id
  organizationId String
  branchId       String
  patientId      String
  providerId     String
  status         PrescriptionStatus @default(DRAFT)
  notes          String?
  issuedById     String?
  issuedAt       DateTime?
  dispensedAt    DateTime?
  cancelledById  String?
  cancelledAt    DateTime?
  cancelReason   String?
  version        Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  provider     User         @relation("PrescriptionProvider", fields: [providerId], references: [id], onDelete: Restrict)

  items PrescriptionItem[]

  @@index([organizationId, patientId, status])
  @@index([organizationId, status, createdAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id                String  @id
  organizationId    String
  prescriptionId    String
  medicationId      String
  quantity          Int
  dispensedQuantity Int     @default(0)
  dosage            String?
  frequency         String?
  durationDays      Int?
  instructions      String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication   Medication   @relation(fields: [medicationId], references: [id], onDelete: Restrict)

  @@index([organizationId, prescriptionId])
  @@map("prescription_items")
}

// ═══════════════════════════════════════════════════════════════════════════
// Billing & invoicing (brief Phase 7)
// ═══════════════════════════════════════════════════════════════════════════

enum BillableItemCategory {
  CONSULTATION
  LAB
  RADIOLOGY
  PHARMACY
  PROCEDURE
  ADMISSION
  OTHER
}

// Overdue is DERIVED at query time (ISSUED/PARTIALLY_PAID with dueAt in the
// past), never stored — it would be a backdated snapshot, not a state.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
  CHEQUE
  INSURANCE
  MPESA // Safaricom M-PESA STK push (repo Phase 11).
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum CoverageType {
  FULL // the payer covers 100%.
  PARTIAL // the payer covers coveragePercent; the patient owes the rest.
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_APPROVED
  DENIED
  PAID
}

// Org price-list item a facility charges for. Prices are money
// (ADR-029): Decimal(12, 2), surfaced to clients as strings.
model BillableItem {
  id                String               @id
  organizationId    String
  branchId          String?
  category          BillableItemCategory
  name              String
  description       String?
  price             Decimal              @db.Decimal(12, 2)
  isActive          Boolean              @default(true)
  insuranceEligible Boolean              @default(false)
  version           Int                  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  invoiceItems InvoiceItem[]

  @@unique([organizationId, name, category])
  @@index([organizationId, category, isActive])
  @@map("billable_items")
}

// Invoice aggregate root. Amount math is Decimal (ADR-029). Status walks
// DRAFT → ISSUED → (PARTIALLY_PAID →) PAID; CANCELLED closes an unpaid
// invoice, REFUNDED closes a fully-refunded one. visitId/encounterId are soft
// forward-pointers so invoicing can attach to a visit/appointment without FK
// coupling across modules.
model Invoice {
  id             String        @id
  organizationId String
  branchId       String
  patientId      String
  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)

  visitId     String?
  encounterId String?

  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)
  balanceDue     Decimal @db.Decimal(12, 2)

  dueAt      DateTime?
  notes      String?
  issuedById String?
  issuedAt   DateTime?

  cancelledById String?
  cancelledAt   DateTime?
  cancelReason  String?
  refundedById  String?
  refundedAt    DateTime?
  refundReason  String?
  version       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  items    InvoiceItem[]
  payments Payment[]
  claims   InsuranceClaim[]
  mpesaRequests MpesaRequest[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, patientId, createdAt])
  @@index([organizationId, branchId, status, createdAt])
  @@map("invoices")
}

// A billed line. Snapshot costs (description + unitPrice) at create time so a
// price-list edit never rewrites history. referenceType/referenceId pin the
// source document (prescription, encounter, visit, ...) as a soft link.
model InvoiceItem {
  id             String  @id
  organizationId String
  invoiceId      String
  billableItemId String?
  medicationId   String?
  description    String
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)
  referenceType  String?
  referenceId    String?
  createdById    String?

  createdAt DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  billableItem BillableItem? @relation(fields: [billableItemId], references: [id], onDelete: SetNull)
  medication   Medication?   @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  @@index([organizationId, invoiceId])
  @@map("invoice_items")
}

// A payment toward an invoice. Created PENDING; settle/complete/fail/refund
// move it (atomic status guards prevent double-apply). COMPLETED payments
// reduce the invoice's balanceDue in the same transaction; refunds restore it.
model Payment {
  id                String        @id
  organizationId    String
  invoiceId         String
  patientId         String
  receiptNumber     String
  amount            Decimal       @db.Decimal(12, 2)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  externalReference String?
  note              String?
  recordedById      String?
  recordedAt        DateTime?
  refundedById      String?
  refundedAt        DateTime?
  refundReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, invoiceId])
  @@index([organizationId, patientId, createdAt])
  @@map("payments")

  mpesaMatches MpesaReconciliationMatch[]
}

// Insurer (NHIF-style, private HMO, ...) a facility works with.
model InsurancePayer {
  id             String  @id
  organizationId String
  name           String
  contactPhone   String?
  email          String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  policies PatientInsurancePolicy[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("insurance_payers")
}

// A patient's active cover under a payer. FULL = payer covers everything;
// PARTIAL = coveragePercent of charges, the patient owes the difference.
model PatientInsurancePolicy {
  id              String       @id
  organizationId  String
  patientId       String
  payerId         String
  policyNumber    String
  coverageType    CoverageType @default(PARTIAL)
  coveragePercent Int          @default(0)
  validityStart   DateTime?
  validityEnd     DateTime?
  isActive        Boolean      @default(true)
  version         Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  payer        InsurancePayer @relation(fields: [payerId], references: [id], onDelete: Restrict)

  claims InsuranceClaim[]

  @@unique([organizationId, patientId, payerId, policyNumber])
  @@index([organizationId, patientId])
  @@map("patient_insurance_policies")
}

// An insurance claim against an invoice. Lifecycle walks
// DRAFT → SUBMITTED → APPROVED (or PARTIALLY_APPROVED / DENIED) → PAID.
// PAID posts an INSURANCE-method payment for the approved amount, which
// reduces the invoice's balanceDue exactly like any other settlement.
model InsuranceClaim {
  id             String      @id
  organizationId String
  claimNumber    String
  invoiceId      String
  policyId       String
  patientId      String
  amount         Decimal     @db.Decimal(12, 2)
  status         ClaimStatus @default(DRAFT)
  notes          String?

  submittedById  String?
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  approvedAmount Decimal?  @db.Decimal(12, 2)
  deniedById     String?
  deniedAt       DateTime?
  denyReason     String?
  paidById       String?
  paidAt         DateTime?
  version        Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice                @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  policy       PatientInsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  patient      Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([organizationId, claimNumber])
  @@index([organizationId, invoiceId])
  @@index([organizationId, patientId, createdAt])
  @@index([organizationId, status])
  @@map("insurance_claims")
}

// ═══════════════════════════════════════════════════════════════════════════
// Financial ledger + M-PESA (brief Phase 7 completion — repo Phase 11)
//
// Double-entry ledger. FinanceTransaction is a journal header; its lines must
// balance by construction (domain assertion), by row (single-side CHECK) and
// by journal (DB trigger on POSTED). Journals append only: reversal creates a
// NEW journal linked via reversalOfId and REVERSES the original status, so
// history is never mutated. Auto-postings are idempotent via the unique
// (organizationId, referenceType, referenceId) key plus the ProcessedEvent
// dedup. FinancialPeriod reasons about time: postings inside a CLOSED or
// LOCKED period are rejected (PERIOD_LOCKED); a posting whose window is
// blocked is recorded as a LedgerPostingException instead of poisoning the
// outbox.
// ═══════════════════════════════════════════════════════════════════════════

enum AccountCategoryType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountNormalBalance {
  DEBIT
  CREDIT
}

enum FinancialPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum FinanceTransactionStatus {
  POSTED
  REVERSED
}

// A position on the org chart of accounts. Codes are org-scoped and unique.
// Defaults are ensured lazily (see src/modules/ledger/domain/ledger-accounts).
model ChartAccount {
  id             String               @id
  organizationId String
  code           String
  name           String
  category       AccountCategoryType
  normalBalance  AccountNormalBalance
  description    String?
  isActive       Boolean              @default(true)
  version        Int                  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lines       FinanceTransactionLine[]

  @@unique([organizationId, code])
  @@index([organizationId, category, isActive])
  @@map("chart_accounts")
}

// A calendar window the org closes and then locks for the auditors.
model FinancialPeriod {
  id             String                @id
  organizationId String
  code           String
  label          String
  startDate      DateTime
  endDate        DateTime
  status         FinancialPeriodStatus @default(OPEN)

  openedById String?
  openedAt   DateTime @default(now())
  closedById String?
  closedAt   DateTime?
  lockedById String?
  lockedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  openBy      User?          @relation("OpenedPeriod", fields: [openedById], references: [id], onDelete: SetNull)
  closedBy    User?          @relation("ClosedPeriod", fields: [closedById], references: [id], onDelete: SetNull)
  lockedBy    User?          @relation("LockedPeriod", fields: [lockedById], references: [id], onDelete: SetNull)
  transactions FinanceTransaction[]

  @@unique([organizationId, code])
  @@index([organizationId, status, startDate])
  @@map("financial_periods")
}

// A posted (or reversed) journal. referenceType/referenceId pin an auto-posting
// to its source event (e.g. referenceType 'Billing.PaymentCompleted'); the
// unique key makes replays no-ops even outside the outbox. Manual journals set
// both null (whitespace-NULL rows are allowed to repeat).
model FinanceTransaction {
  id                String                   @id
  organizationId    String
  periodId          String?
  transactionNumber String
  date              DateTime
  description       String?
  referenceType     String?
  referenceId       String?
  status            FinanceTransactionStatus @default(POSTED)

  postedById String?
  postedAt   DateTime @default(now())
  reversedById String?
  reversedAt   DateTime?
  reversalOfId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  period      FinancialPeriod?         @relation(fields: [periodId], references: [id], onDelete: SetNull)
  postedBy    User?                    @relation("PostedJournal", fields: [postedById], references: [id], onDelete: SetNull)
  reversedBy  User?                    @relation("ReversedJournal", fields: [reversedById], references: [id], onDelete: SetNull)
  reversalOf  FinanceTransaction?      @relation("ReversalChain", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals   FinanceTransaction[]     @relation("ReversalChain")
  lines       FinanceTransactionLine[]

  @@unique([organizationId, transactionNumber])
  @@unique([organizationId, referenceType, referenceId])
  @@index([organizationId, date, status])
  @@index([organizationId, periodId])
  @@map("finance_transactions")
}

// A leg of a journal. Each leg moves a single side (>0 debit XOR >0 credit);
// the DB CHECK below is the row-level backstop for the domain assertion.
model FinanceTransactionLine {
  id             String   @id
  organizationId String
  transactionId  String
  accountId      String
  debit          Decimal  @default(0) @db.Decimal(12, 2)
  credit         Decimal  @default(0) @db.Decimal(12, 2)
  memo           String?

  createdAt DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transaction FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     ChartAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([organizationId, transactionId])
  @@index([organizationId, accountId])
  @@map("finance_transaction_lines")
}

// Auditable record of a posting the outbox skipped because its window fell in
// a closed/locked period (see ADR-035). Written by LedgerPostingConsumer.
model LedgerPostingException {
  id             String   @id
  organizationId String
  eventId        String
  eventType      String
  referenceType  String?
  referenceId    String?
  reason         String

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@unique([organizationId, eventId])
  @@map("ledger_posting_exceptions")
}

enum MpesaRequestStatus {
  PENDING
  SUCCEEDED
  FAILED
  MISMATCHED
  EXPIRED
  CANCELLED
}

// One STK push. Created PENDING at initiation; the callback confirms it
// (SUCCEEDED), fails it, or flags an amount mismatch for reconciliation.
model MpesaRequest {
  id                String            @id
  organizationId    String
  branchId          String?
  invoiceId         String
  patientId         String
  phone             String
  amount            Decimal           @db.Decimal(12, 2)
  checkoutRequestId String
  merchantRequestId String
  status            MpesaRequestStatus @default(PENDING)

  resultCode         String?
  resultDesc         String?
  rawCallback        Json?
  initiatedById      String?
  initiatedAt        DateTime @default(now())
  callbackReceivedAt DateTime?
  confirmedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch      Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  initiatedBy User?        @relation(fields: [initiatedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, checkoutRequestId])
  @@unique([merchantRequestId])
  @@index([organizationId, status, initiatedAt])
  @@index([organizationId, invoiceId])
  @@map("mpesa_requests")

  reconciliationMatches MpesaReconciliationMatch[]
}

enum MpesaReconciliationMatchStatus {
  MATCHED
  UNMATCHED
  DUPLICATE
  AMOUNT_MISMATCH
  REFERENCE_MISMATCH
}

// A reconciliation run over a window of provider STK requests vs internal
// MPESA payments. Summary counters live on the run; per-item verdicts on the
// matches; accountant resolutions are audited stamps, never row mutations of
// the underlying payment/request.
model MpesaReconciliationRun {
  id             String   @id
  organizationId String
  windowFrom     DateTime
  windowTo       DateTime

  providerCount          Int @default(0)
  paymentCount           Int @default(0)
  matchedCount           Int @default(0)
  unmatchedCount         Int @default(0)
  duplicateCount         Int @default(0)
  amountMismatchCount    Int @default(0)
  referenceMismatchCount Int @default(0)

  runById   String?
  startedAt DateTime @default(now())
  completedAt DateTime @default(now())

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  runBy       User?        @relation(fields: [runById], references: [id], onDelete: SetNull)
  matches     MpesaReconciliationMatch[]

  @@index([organizationId, createdAt])
  @@map("mpesa_reconciliation_runs")
}

// A single verdict + (optional) audited resolution.
model MpesaReconciliationMatch {
  id             String                          @id
  organizationId String
  runId          String
  mpesaRequestId String?
  paymentId      String?
  reference      String
  status         MpesaReconciliationMatchStatus
  expectedAmount Decimal?  @db.Decimal(12, 2)
  providerAmount Decimal?  @db.Decimal(12, 2)
  notes          String?

  resolution        String?
  resolutionReason  String?
  resolvedById      String?
  resolvedAt        DateTime?

  createdAt DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  run         MpesaReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  mpesaRequest MpesaRequest?        @relation(fields: [mpesaRequestId], references: [id], onDelete: SetNull)
  payment     Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  resolvedBy  User?                 @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([organizationId, runId])
  @@index([organizationId, status])
  @@map("mpesa_reconciliation_matches")
}

// ============================================================================
// Laboratory & radiology (brief Phase 6)
//
// LabOrders are the workflow aggregate (entity type 'lab_order'); LabSample
// mirrors the order's progress through a pure status mapping (both are updated
// in the same transaction, so they never drift). Results are versioned:
// routine corrections produce a new LabResultVersion, and post-release edits
// are amendments that keep the original author + a revisionReason. Reference
// ranges and critical thresholds live on LabTestField (org-configured); the
// abnormal/critical flags are pure functions of those configured values only.
// Radiology keeps its own order workflow ('radiology_order'); DICOM is out of
// scope (ImagingProvider/PacsGateway interfaces are no-op in src/integrations).
// ============================================================================

enum LabTestFieldType {
  NUMERIC
  TEXT
  CATEGORICAL
}

enum LabOrderStatus {
  ORDERED
  COLLECTED
  RECEIVED
  PROCESSING
  RESULT_READY
  VERIFIED
  RELEASED
  REJECTED
  CANCELLED
}

enum LabSampleStatus {
  ORDERED
  COLLECTED
  RECEIVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum LabSampleType {
  BLOOD
  URINE
  STOOL
  SWAB
  SPUTUM
  TISSUE
  FLUID
  OTHER
}

enum LabOrderPriority {
  ROUTINE
  URGENT
  STAT
}

enum RadiologyOrderStatus {
  ORDERED
  SCHEDULED
  PERFORMED
  REPORTED
  VERIFIED
  RELEASED
  CANCELLED
}

enum ImagingModality {
  XRAY
  CT
  MRI
  ULTRASOUND
  MAMMOGRAPHY
  DEXA
  FLUOROSCOPY
  OTHER
}

// A grouping of panel-style lab tests (e.g. Hematology, Biochemistry).
model LabTestCategory {
  id             String  @id
  organizationId String
  name           String
  description    String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tests        LabTest[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("lab_test_categories")
}

// A lab test offered by the facility. version enables optimistic locking on
// catalog edits; no price here (pricing is a billing (Phase 7) concern).
model LabTest {
  id                   String        @id
  organizationId       String
  code                 String
  name                 String
  categoryId           String?
  sampleType           LabSampleType @default(OTHER)
  specimenInstructions String?
  isActive             Boolean       @default(true)
  version              Int           @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     LabTestCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  fields       LabTestField[]
  orderItems   LabOrderItem[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@index([organizationId, categoryId, isActive])
  @@map("lab_tests")
}

// A measurable/output field of a test with org-configured units, reference
// range and critical thresholds. NUMERIC carries the ranges; TEXT/CATEGORICAL
// may define allowed values (allowsValues). Flags are derived FROM THESE ONLY.
model LabTestField {
  id             String           @id
  organizationId String
  testId         String
  name           String
  fieldType      LabTestFieldType @default(NUMERIC)
  unit           String?
  referenceMin   Decimal?         @db.Decimal(12, 4)
  referenceMax   Decimal?         @db.Decimal(12, 4)
  criticalMin    Decimal?         @db.Decimal(12, 4)
  criticalMax    Decimal?         @db.Decimal(12, 4)
  allowsValues   String?
  displayOrder   Int              @default(0)
  isActive       Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  test         LabTest      @relation(fields: [testId], references: [id], onDelete: Cascade)
  results      LabResult[]

  @@index([organizationId, testId, isActive])
  @@map("lab_test_fields")
}

// A laboratory order (workflow aggregate). encounterId is a soft pointer to
// the source encounter/visit (RLS scoping follows patientId+branchId). When a
// sample is rejected and re-collected, a NEW order is linked via
// LabSample.recollectsFromOrderId; rememberingOrderId points back for audit.
model LabOrder {
  id              String           @id
  organizationId  String
  orderNumber     String
  patientId       String
  branchId        String
  encounterId     String?
  status          LabOrderStatus   @default(ORDERED)
  priority        LabOrderPriority @default(ROUTINE)
  clinicalNotes   String?
  orderedById     String?
  orderedAt       DateTime         @default(now())
  rejectionReason String?
  cancelledById   String?
  cancelledAt     DateTime?
  cancelledReason String?
  releasedById    String?
  releasedAt      DateTime?
  version         Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  items   LabOrderItem[]
  samples LabSample[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, patientId, createdAt])
  @@index([organizationId, branchId, status, createdAt])
  @@map("lab_orders")
}

// A line of a lab order - pins the catalog test that was ordered.
model LabOrderItem {
  id             String  @id
  organizationId String
  orderId        String
  testId         String
  notes          String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        LabOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test         LabTest      @relation(fields: [testId], references: [id], onDelete: Restrict)

  results LabResult[]

  @@unique([organizationId, orderId, testId])
  @@index([organizationId, orderId])
  @@map("lab_order_items")
}

// The physical specimen. Number LAB-SMP-<YYYY>-<xxxxxx> via the org counter
// 'lab_sample_number'. Status mirrors the order through a pure mapping and is
// kept in sync inside the same transaction as the order transition.
model LabSample {
  id             String          @id
  organizationId String
  sampleNumber   String
  orderId        String
  patientId      String
  branchId       String
  sampleType     LabSampleType   @default(BLOOD)
  status         LabSampleStatus @default(ORDERED)

  collectedById         String?
  collectedAt           DateTime?
  receivedById          String?
  receivedAt            DateTime?
  processingById        String?
  processingAt          DateTime?
  completedById         String?
  completedAt           DateTime?
  rejectedAt            DateTime?
  rejectedReason        String?
  recollectsFromOrderId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        LabOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([organizationId, sampleNumber])
  @@index([organizationId, orderId])
  @@index([organizationId, patientId, createdAt])
  @@index([organizationId, status])
  @@map("lab_samples")
}

// A result value, one per (order item, test field). createdBy/verifiedBy and
// versioned history live on versions; the latest version is denormalized.
model LabResult {
  id             String  @id
  organizationId String
  orderItemId    String
  testFieldId    String
  currentVersion Int     @default(1)
  value          String
  isAbnormal     Boolean @default(false)
  isCritical     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderItem    LabOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  testField    LabTestField @relation(fields: [testFieldId], references: [id], onDelete: Restrict)

  versions    LabResultVersion[]
  criticality CriticalResult?

  @@unique([organizationId, orderItemId, testFieldId])
  @@index([organizationId, testFieldId])
  @@map("lab_results")
}

// Immutable history. If the result is entered/held then corrected on
// version 1, revisionNumber stays 1 with reason = correction; a change AFTER
// RELEASE bumps revisionNumber and requires reason (an amendment, as the brief
// requires an audit trail for changes after release).
model LabResultVersion {
  id             String    @id
  organizationId String
  resultId       String
  revisionNumber Int       @default(1)
  value          String
  isAbnormal     Boolean   @default(false)
  isCritical     Boolean   @default(false)
  enteredById    String?
  verifiedById   String?
  verifiedAt     DateTime?
  amended        Boolean   @default(false)
  reason         String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  result       LabResult    @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([organizationId, resultId, revisionNumber])
  @@index([organizationId, resultId])
  @@map("lab_result_versions")
}

// A critical result awaiting clinical acknowledgement. Release is blocked
// until every flagged result has been acknowledged. notifiedToId is the
// ordering clinician (order.orderedById) unless otherwise set.
model CriticalResult {
  id               String    @id
  organizationId   String
  resultId         String    @unique
  notifiedToId     String
  notifiedAt       DateTime  @default(now())
  acknowledgedById String?
  acknowledgedAt   DateTime?
  escalationAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  result       LabResult    @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([organizationId, resultId])
  @@index([organizationId, acknowledgedById, acknowledgedAt])
  @@map("critical_results")
}

// A radiology order (workflow aggregate, entity 'radiology_order').
model RadiologyOrder {
  id              String               @id
  organizationId  String
  orderNumber     String
  patientId       String
  branchId        String
  encounterId     String?
  modality        ImagingModality      @default(OTHER)
  region          String?
  status          RadiologyOrderStatus @default(ORDERED)
  clinicalNotes   String?
  orderedById     String?
  orderedAt       DateTime             @default(now())
  requestedAt     DateTime?
  performedById   String?
  performedAt     DateTime?
  cancelledById   String?
  cancelledAt     DateTime?
  cancelledReason String?
  releasedById    String?
  releasedAt      DateTime?
  version         Int                  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  report ImagingReport?

  @@unique([organizationId, orderNumber])
  @@index([organizationId, patientId, createdAt])
  @@index([organizationId, branchId, status, createdAt])
  @@map("radiology_orders")
}

// 1:1 radiology report. Finding/summary entered then verified then released
// with the order; attachments are document URLs (storage handled elsewhere).
model ImagingReport {
  id             String    @id
  organizationId String
  orderId        String    @unique
  findings       String?
  summary        String?
  impression     String?
  enteredById    String?
  enteredAt      DateTime?
  verifiedById   String?
  verifiedAt     DateTime?
  version        Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        RadiologyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([organizationId, orderId])
  @@map("imaging_reports")
}

// ---------------------------------------------------------------------------
// Inpatient & emergency (brief Phase 8). Wards → rooms → beds; admissions with
// bed assignments (one patient per active bed, enforced by a PARTIAL UNIQUE
// INDEX on active assignments added in the migration); discharge with summary.
// Emergency covers Arrival → Triage → Assessment → Treatment → Observation →
// Admission | Referral | Discharge with priority set by clinicians only.
// ---------------------------------------------------------------------------

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MAINTENANCE
  BLOCKED
}

enum AdmissionSource {
  EMERGENCY
  OUTPATIENT_CLINIC
  REFERRAL
  PLANNED
  DIRECT
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
}

enum EmergencyVisitStatus {
  ARRIVED
  TRIAGED
  ASSESSED
  IN_TREATMENT
  OBSERVATION
  DISCHARGED
  ADMITTED
  REFERRED
}

enum EmergencyPriority {
  RESUSCITATION
  EMERGENT
  URGENT
  SEMI_URGENT
  NON_URGENT
}

enum EmergencyDisposition {
  ADMITTED
  REFERRED
  DISCHARGED
}

// A hospital ward, scoped to a branch. Contains rooms, which contain beds.
model Ward {
  id             String  @id
  organizationId String
  branchId       String
  name           String
  code           String?
  floor          String?
  description    String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  rooms Room[]

  @@unique([organizationId, branchId, name])
  @@index([organizationId, branchId, isActive])
  @@map("wards")
}

// A room within a ward (e.g. "A-101"). Beds live under rooms.
model Room {
  id             String  @id
  organizationId String
  wardId         String
  name           String
  description    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ward         Ward         @relation(fields: [wardId], references: [id], onDelete: Cascade)

  beds Bed[]

  @@unique([organizationId, wardId, name])
  @@index([organizationId, wardId])
  @@map("rooms")
}

// A physical bed. status is the working state; OCCUPIED is assignment-driven
// and is never set directly (available/reserved/cleaning/maintenance/blocked
// go through the status endpoint with optimistic locking via `version`).
model Bed {
  id             String    @id
  organizationId String
  roomId         String
  bedNumber      String
  status         BedStatus @default(AVAILABLE)
  version        Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  room         Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)

  assignments BedAssignment[]

  @@unique([organizationId, roomId, bedNumber])
  @@index([organizationId, roomId, status])
  @@index([organizationId, status])
  @@map("beds")
}

// A stay of an admission in a bed. Transfer/readmission history is preserved:
// a transfer closes the current row (releasedAt) and opens a new one, so every
// bed an admission occupied is reconstructable. One-bed-one-patient is enforced
// by a PARTIAL UNIQUE INDEX on (organizationId, bedId) WHERE releasedAt IS NULL
// created in the migration (Prisma cannot declare partial indexes) PLUS a row
// lock on the bed inside the assignment transaction (brief §6.9).
model BedAssignment {
  id             String    @id
  organizationId String
  bedId          String
  admissionId    String
  assignedById   String
  assignedAt     DateTime  @default(now())
  releasedById   String?
  releasedAt     DateTime?
  reason         String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bed          Bed          @relation(fields: [bedId], references: [id], onDelete: Restrict)
  admission    Admission    @relation(fields: [admissionId], references: [id], onDelete: Restrict)
  assignedBy   User         @relation("BedAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  releasedBy   User?        @relation("BedReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)

  @@index([organizationId, bedId, releasedAt])
  @@index([organizationId, admissionId, assignedAt])
  @@map("bed_assignments")
}

// An inpatient admission (workflow aggregate, entity type 'admission').
// Doctor authorizes (permission inpatient.create) → available bed row-locked →
// admission created → bed assigned → patient is inpatient. Number ADM-<YYYY>-NNNNNN.
model Admission {
  id                   String          @id
  organizationId       String
  admissionNumber      String
  patientId            String
  branchId             String
  departmentId         String? // soft pointer: admitting department/service.
  encounterId          String? // soft pointer to the source encounter.
  source               AdmissionSource @default(OUTPATIENT_CLINIC)
  status               AdmissionStatus @default(ADMITTED)
  admittedById         String?
  admittedAt           DateTime        @default(now())
  expectedDischargeAt  DateTime?
  provisionalDiagnosis String?

  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  admittedBy   User?        @relation("AdmissionAdmittedBy", fields: [admittedById], references: [id], onDelete: SetNull)

  assignments BedAssignment[]
  discharge   Discharge?

  @@unique([organizationId, admissionNumber])
  @@index([organizationId, patientId, admittedAt])
  @@index([organizationId, branchId, status, admittedAt])
  @@map("admissions")
}

// 1:1 discharge record. Discharge closes the active bed assignment and flips
// the bed to CLEANING in the same transaction. The discharge-summary PDF is
// generated asynchronously (a later phase); this row holds the structured
// content. Medications/follow-up carry IDs/structure, never PHI blobs.
model Discharge {
  id                    String   @id
  organizationId        String
  admissionId           String   @unique
  dischargedById        String?
  dischargedAt          DateTime @default(now())
  summary               String?
  instructions          String?
  medications           Json? // [{ name, dose, instructions }]
  followUp              Json? // { type, date, notes } — structured plan
  hasOutstandingBilling Boolean  @default(false)
  documentIds           Json? // discharge documents/scans (document service ids)
  version               Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  admission    Admission    @relation(fields: [admissionId], references: [id], onDelete: Restrict)
  dischargedBy User?        @relation("DischargeDischargedBy", fields: [dischargedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, admissionId])
  @@index([organizationId, dischargedAt])
  @@map("discharges")
}

// An emergency department visit (workflow aggregate, entity type
// 'emergency_visit'). Timestamps for arrival/triage/assessment/treatment/
// observation/disposition feed ED performance analytics. Priority is recorded
// ONLY by authorized clinicians (permission emergency.triage). Number ER-<YYYY>-NNNNNN.
model EmergencyVisit {
  id                  String                @id
  organizationId      String
  visitNumber         String
  branchId            String
  patientId           String
  status              EmergencyVisitStatus  @default(ARRIVED)
  priority            EmergencyPriority?
  registeredById      String?
  arrivedById         String?
  arrivedAt           DateTime              @default(now())
  chiefComplaint      String?
  triagedById         String?
  triagedAt           DateTime?
  assessedAt          DateTime?
  assessment          String? // clinical assessment recorded by the clinician.
  treatmentStartedAt  DateTime?
  treatment           String? // treatment started in the emergency department.
  observedAt          DateTime?
  dispositionAt       DateTime?
  disposition         EmergencyDisposition?
  admittedAdmissionId String? // soft pointer to the Admission created on ADMIT.
  referredTo          String? // referral destination on REFERRED.
  referralNotes       String?

  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([organizationId, visitNumber])
  @@index([organizationId, branchId, status, arrivedAt])
  @@index([organizationId, patientId, arrivedAt])
  @@map("emergency_visits")
}

// ---------------------------------------------------------------------------
// Communication & documents (brief Phase 9 / repo Phase 10). Notifications,
// templates, preferences, secure in-org messaging (append-only), telemedicine
// sessions (consent-gated), feedback, complaints and incident reporting.
// Notification bodies/templates are neutral (never carry PHI); the payload of
// the underlying outbox event carries IDs only.
// ---------------------------------------------------------------------------

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id                 String              @id
  organizationId     String
  recipientUserId    String? // present for staff recipients.
  recipientPatientId String? // present for patient recipients.
  channel            NotificationChannel
  templateKey        String // resolves against NotificationTemplate.key.
  subject            String
  body               String
  variables          Json? // only values allow-listed on the template.
  status             NotificationStatus  @default(PENDING)
  attemptCount       Int                 @default(0)
  errorCode          String?
  readAt             DateTime? // IN_APP acknowledgement.
  sentAt             DateTime?
  createdAt          DateTime            @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recipientUser    User?        @relation("NotificationRecipientUser", fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientPatient Patient?     @relation("NotificationRecipientPatient", fields: [recipientPatientId], references: [id], onDelete: Cascade)

  @@index([organizationId, recipientUserId, createdAt])
  @@index([organizationId, recipientPatientId, createdAt])
  @@index([organizationId, status, createdAt])
  @@map("notifications")
}

// Org-scoped neutral templates. `allowlistedVariables` is the set of variable
// keys the renderer accepts; anything else is rejected so notifications can
// never leak clinical data.
model NotificationTemplate {
  id                   String   @id
  organizationId       String
  key                  String   @unique
  name                 String
  description          String?
  subjectTemplate      String
  bodyTemplate         String
  allowlistedVariables String[] // rendered via [key] substitution.
  isDefault            Boolean  @default(false)
  isActive             Boolean  @default(true)
  updatedById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  updatedBy    User?        @relation("NotificationTemplateEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([organizationId, isActive])
  @@map("notification_templates")
}

model NotificationPreference {
  id                 String              @id
  organizationId     String
  recipientUserId    String? // staff preference; xor with recipientPatientId.
  recipientPatientId String? // patient preference.
  category           String // matches the template key / purpose.
  channel            NotificationChannel
  enabled            Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recipientUser    User?        @relation("NotificationPreferenceUser", fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientPatient Patient?     @relation("NotificationPreferencePatient", fields: [recipientPatientId], references: [id], onDelete: Cascade)

  @@unique([organizationId, recipientUserId, category, channel])
  @@unique([organizationId, recipientPatientId, category, channel])
  @@map("notification_preferences")
}

model Conversation {
  id             String   @id
  organizationId String
  branchId       String?
  subject        String
  patientId      String? // optional clinical context; messages remain PHI-strict.
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("ConversationStarter", fields: [createdById], references: [id], onDelete: Restrict)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)

  participants ConversationParticipant[]
  messages     ConversationMessage[]

  @@index([organizationId, branchId, createdAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id
  organizationId String
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, conversationId, userId])
  @@map("conversation_participants")
}

// Append-only: no update or delete endpoint is exposed; edits/appends create
// new rows so the clinical thread is immutable once written.
model ConversationMessage {
  id             String   @id
  organizationId String
  conversationId String
  senderId       String
  body           String
  documentId     String? // optional shareable attachment.
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("ConversationMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  document     Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([organizationId, conversationId, createdAt])
  @@map("conversation_messages")
}

enum VirtualSessionStatus {
  SCHEDULED
  STARTED
  ENDED
  CANCELLED
  NO_SHOW
}

enum FeedbackCategory {
  SERVICE
  WAITING_TIME
  STAFF
  BILLING
  FACILITY
  PHARMACY
  LABORATORY
  OTHER
}

enum FeedbackStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
  CLOSED
}

model Feedback {
  id             String           @id
  organizationId String
  branchId       String?
  patientId      String?
  submittedById  String? // staff may log feedback on behalf of a patient.
  category       FeedbackCategory
  rating         Int
  comment        String?
  status         FeedbackStatus   @default(NEW)
  response       String?
  handledById    String?
  handledAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  submittedBy  User?        @relation("FeedbackSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  handledBy    User?        @relation("FeedbackHandler", fields: [handledById], references: [id], onDelete: SetNull)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([organizationId, branchId, status, createdAt])
  @@map("feedback")
}

enum ComplaintOrigin {
  PATIENT
  STAFF
  OTHER
}

enum ComplaintStatus {
  OPEN
  ASSIGNED
  INVESTIGATING
  RESOLVED
  CLOSED
}

model Complaint {
  id             String          @id
  organizationId String
  branchId       String?
  origin         ComplaintOrigin
  patientId      String?
  submittedById  String? // may be a patient account or staff member.
  category       String
  description    String
  status         ComplaintStatus @default(OPEN)
  assignedToId   String?
  dueAt          DateTime?
  resolution     String?
  closedById     String?
  closedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  submittedBy  User?        @relation("ComplaintSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("ComplaintAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  closedBy     User?        @relation("ComplaintCloser", fields: [closedById], references: [id], onDelete: SetNull)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([organizationId, branchId, status, createdAt])
  @@map("complaints")
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentCategory {
  OUTAGE
  EQUIPMENT
  STOCK_DISCREPANCY
  DATA_ACCESS
  FACILITY
  PATIENT_SAFETY
  OTHER
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  ACTION_PLAN
  RESOLVED
  CLOSED
}

model Incident {
  id             String           @id
  organizationId String
  branchId       String
  category       IncidentCategory
  severity       IncidentSeverity
  description    String
  reportedById   String
  status         IncidentStatus   @default(OPEN)
  actionsTaken   String?
  resolution     String?
  resolvedById   String?
  resolvedAt     DateTime?
  closedById     String?
  closedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reportedBy   User         @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  resolvedBy   User?        @relation("IncidentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  closedBy     User?        @relation("IncidentCloser", fields: [closedById], references: [id], onDelete: SetNull)

  @@index([organizationId, branchId, status, severity, createdAt])
  @@index([organizationId, category, createdAt])
  @@map("incidents")
}

// ─── Operations (brief Phase 10, repo Phase 12) ──────────────────────────────

enum ExpenseCategory {
  SUPPLIES
  EQUIPMENT
  MAINTENANCE
  UTILITIES
  RENT
  SALARIES_AND_BENEFITS
  TRANSPORT
  FOOD_AND_NUTRITION
  TELECOMMUNICATIONS
  MARKETING
  OTHER
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ExpensePaymentStatus {
  UNPAID
  PAID
}

// An organization operating expense. Money is Decimal(12,2) (ADR-029). The
// approval workflow is code-owned (approver may not be the creator); once
// APPROVED the expense posts to the ledger (DR 5000 expense / CR 2100 AP) via
// the outbox consumer, and paying it clears AP against cash (DR 2100 / CR 1000).
model Expense {
  id             String                @id
  organizationId String
  branchId       String
  departmentId   String?
  supplierId     String?
  expenseNumber  String
  category       ExpenseCategory
  description    String?
  reference      String? // supplier invoice / purchase reference
  amount         Decimal               @db.Decimal(12, 2)
  status         ExpenseStatus         @default(DRAFT)
  paymentStatus  ExpensePaymentStatus  @default(UNPAID)
  version        Int                   @default(0)

  createdById   String
  submittedById String?
  approvedById  String?
  rejectedById  String?
  rejectReason  String?
  paidById      String?
  submittedAt   DateTime?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  paidAt        DateTime?
  cancelledById String?
  cancelledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([organizationId, expenseNumber])
  @@index([organizationId, status, paymentStatus])
  @@index([organizationId, supplierId, status])
  @@index([organizationId, category, createdAt])
  @@map("expenses")
}

enum AssetCategory {
  EQUIPMENT
  COMPUTER
  VEHICLE
  BED
  MACHINE
  INSTRUMENT
  FURNITURE
  OTHER
}

enum AssetStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
  DISPOSED
}

// Physical assets (equipment, computers, vehicles, beds, machines). An asset
// tag is org-unique; maintenance history lives on MaintenanceRecord.
model Asset {
  id             String       @id
  organizationId String
  branchId       String?
  departmentId   String?
  assetTag       String
  category       AssetCategory
  name           String
  serialNumber   String?
  location       String?
  status         AssetStatus  @default(ACTIVE)
  purchaseDate   DateTime?
  purchaseCost   Decimal?     @db.Decimal(12, 2)
  notes          String?
  version        Int          @default(0)

  retiredById String?
  retiredAt   DateTime?
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  maintenanceRecords MaintenanceRecord[]

  @@unique([organizationId, assetTag])
  @@index([organizationId, status, category])
  @@index([organizationId, branchId, status])
  @@map("assets")
}

enum MaintenanceStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// A scheduled maintenance job for an asset. scheduledFor is the next service
// date; reminders are queued (MaintenanceReminder) for PLANNED/IN_PROGRESS
// records whose scheduledFor falls inside the reminder horizon.
model MaintenanceRecord {
  id              String            @id
  organizationId  String
  assetId         String
  status          MaintenanceStatus @default(PLANNED)
  scheduledFor    DateTime
  completedAt     DateTime?
  downtimeHours   Int?
  cost            Decimal?          @db.Decimal(12, 2)
  serviceProvider String?
  notes           String?
  version         Int               @default(0)

  createdById   String?
  completedById String?
  cancelledById String?
  cancelledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)

  reminders MaintenanceReminder[]

  @@index([organizationId, assetId])
  @@index([organizationId, status, scheduledFor])
  @@map("maintenance_records")
}

enum MaintenanceReminderStatus {
  QUEUED
  SENT
}

// An ordered reminder for a maintenance record. Exactly one reminder can exist
// per maintenance record (unique key) so the queue scan is idempotent: a
// repeated run never creates duplicates.
model MaintenanceReminder {
  id             String                     @id
  organizationId String
  maintenanceId  String
  dueAt          DateTime
  status         MaintenanceReminderStatus  @default(QUEUED)

  queuedById String?
  queuedAt   DateTime @default(now())
  sentAt     DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  maintenance  MaintenanceRecord @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, maintenanceId])
  @@index([organizationId, status, dueAt])
  @@map("maintenance_reminders")
}
