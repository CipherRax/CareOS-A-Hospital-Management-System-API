generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// ---------------------------------------------------------------------------
// IDs
//
// All primary keys are UUIDv7 (time-ordered) generated in application code via
// `newId()`. Prisma does not assign defaults; every create passes an explicit
// id. Sequential database ids are never exposed as business identifiers.
// ---------------------------------------------------------------------------

enum OrgStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
  DEAD
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  REJECTED
}

// ---------------------------------------------------------------------------
// Tenant root. Row-level tenancy: every tenant-owned table carries
// organizationId and foreign keys to Organization.
// ---------------------------------------------------------------------------
model Organization {
  id   String @id
  name String

  legalName          String?
  tradingName        String?
  registrationNumber String?
  kraPin             String?
  phone              String?
  email              String?
  website            String?
  logoUrl            String?
  address            String?
  county             String?
  town               String?

  status    OrgStatus @default(ACTIVE)
  currency  String    @default("KES")
  timezone  String    @default("Africa/Nairobi")
  country   String    @default("KE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  outboxEvents         OutboxEvent[]
  auditLogs            AuditLog[]
  idempotencyRecords   IdempotencyRecord[]
  processedEvents      ProcessedEvent[]
  counters             Counter[]
  branches             Branch[]
  departments          Department[]
  users                User[]
  roles                Role[]
  sessions             Session[]
  refreshTokens        RefreshToken[]
  staffProfiles        StaffProfile[]
  userBranchLinks      UserBranch[]
  userDepartmentLinks  UserDepartment[]
  userRoleLinks        UserRole[]
  mfaCredentials       MfaCredential[]
  mfaRecoveryCodes     MfaRecoveryCode[]
  breakGlassGrants     BreakGlassGrant[]
  documents            Document[]
  patients             Patient[]
  guardians            Guardian[]
  patientGuardianLinks PatientGuardian[]
  consents             PatientConsent[]
  allergies            Allergy[]
  medicalHistory       MedicalHistoryEntry[]
  patientAccessLogs    PatientAccessLog[]
  patientTimelines     PatientTimelineEntry[]

  organizationSettings  OrganizationSetting[]
  providerSchedules     ProviderSchedule[]
  scheduleOverrides     ScheduleOverride[]
  appointments          Appointment[]
  waitlistEntries       WaitlistEntry[]
  visits                Visit[]
  queueEntries          QueueEntry[]
  vitalRecords          VitalRecord[]
  displayDevices        DisplayDevice[]
}

// ---------------------------------------------------------------------------
// Transactional outbox. Business rows and OutboxEvent rows are written in the
// same DB transaction via TxRunner. The worker publishes eligible events with
// FOR UPDATE SKIP LOCKED and dispatches via BullMQ.
// ---------------------------------------------------------------------------
model OutboxEvent {
  id             String       @id
  organizationId String
  type           String
  version        Int          @default(1)
  status         OutboxStatus @default(PENDING)
  aggregateType  String
  aggregateId    String
  occurredAt     DateTime     @default(now())
  actorId        String?
  correlationId  String?
  payload        Json // minimal: IDs only, never PHI
  attemptCount   Int          @default(0)
  lastError      String?
  nextAttemptAt  DateTime?
  publishedAt    DateTime?
  deadAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@map("outbox_events")
}

// Consumer idempotency — a consumer may process a given event exactly once.
model ProcessedEvent {
  id             String   @id
  organizationId String
  consumer       String
  eventId        String
  consumedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, consumer, eventId])
  @@index([organizationId, consumedAt])
  @@map("processed_events")
}

// Append-only audit trail. Deletion/update is blocked at the DB level by a
// trigger; the application exposes no update/delete path.
model AuditLog {
  id             String  @id
  organizationId String
  branchId       String?
  userId         String?
  action         String
  resource       String
  resourceId     String?
  ip             String?
  userAgent      String?
  requestId      String?
  reason         String?
  previousState  Json?
  newState       Json?
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, resource, resourceId, createdAt])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// Idempotency: unique per (organizationId, scopeKey, idempotencyKey). Same key
// + same payload replays the stored response; same key + different payload is
// rejected with IDEMPOTENCY_KEY_REUSED.
model IdempotencyRecord {
  id             String            @id
  organizationId String
  scopeKey       String
  idempotencyKey String
  requestHash    String
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  requestBody    Json?
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, scopeKey, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// Organization-scoped locked counters (patient/invoice/sample number series).
// Rows are updated under `SELECT ... FOR UPDATE`; never derived from DB ids.
model Counter {
  id             String @id
  organizationId String
  key            String
  value          BigInt @default(0)

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("counters")
}

// ---------------------------------------------------------------------------
// Identity & access (Phase 1)
// ---------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum DepartmentKind {
  STANDARD
  CUSTOM
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  CONTRACT
}

enum BreakGlassStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
}

model Branch {
  id             String       @id
  organizationId String
  name           String
  code           String
  address        String?
  phone          String?
  email          String?
  operatingHours String?
  status         BranchStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userLinks    UserBranch[]

  providerSchedules ProviderSchedule[]
  scheduleOverrides ScheduleOverride[]
  appointments      Appointment[]
  waitlistEntries   WaitlistEntry[]
  visits            Visit[]
  queueEntries      QueueEntry[]
  displayDevices    DisplayDevice[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model Department {
  id             String         @id
  organizationId String
  name           String
  code           String?
  kind           DepartmentKind @default(STANDARD)
  active         Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userDepartmentLinks UserDepartment[]

  providerSchedules ProviderSchedule[]
  scheduleOverrides ScheduleOverride[]
  appointments      Appointment[]
  waitlistEntries   WaitlistEntry[]
  visits            Visit[]
  queueEntries      QueueEntry[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model User {
  id                String     @id
  organizationId    String
  email             String
  phone             String?
  firstName         String
  lastName          String
  otherNames        String?
  passwordHash      String?
  status            UserStatus @default(INVITED)
  lastLoginAt       DateTime?
  loginFailureCount Int        @default(0)
  lockedUntil       DateTime?

  inviteTokenHash             String?
  inviteTokenExpiresAt        DateTime?
  passwordResetTokenHash      String?
  passwordResetTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  staffProfile     StaffProfile?
  userBranches     UserBranch[]
  userDepartments  UserDepartment[]
  userRoles        UserRole[]
  sessions         Session[]
  mfaCredential    MfaCredential?
  mfaRecoveryCodes MfaRecoveryCode[]
  breakGlassGrants BreakGlassGrant[]
  documents        Document[]

  providerSchedules       ProviderSchedule[]    @relation("ScheduleProvider")
  scheduleOverrides       ScheduleOverride[]    @relation("ScheduleOverrideProvider")
  appointmentsProvided    Appointment[]         @relation("AppointmentProvider")
  appointmentsCreatedBy   Appointment[]         @relation("AppointmentCreatedBy")
  visitsRegistered        Visit[]               @relation("VisitRegisteredBy")
  vitalRecordsRecorded    VitalRecord[]         @relation("VitalRecordedBy")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model StaffProfile {
  id                String           @id
  organizationId    String
  userId            String           @unique
  staffNumber       String
  professionalTitle String?
  specialization    String?
  employmentStatus  EmploymentStatus @default(ACTIVE)
  availability      Boolean          @default(true)
  // Professional license / registration identifier (treated as sensitive; field
  // encryption lands later — see docs/limitations.md).
  licenseNumber     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, staffNumber])
  @@index([organizationId])
  @@map("staff_profiles")
}

// A user may belong to several branches; branch access is a permission, not a default.
model UserBranch {
  id             String @id
  organizationId String
  userId         String
  branchId       String

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, branchId])
  @@index([organizationId, branchId])
  @@map("user_branches")
}

model UserDepartment {
  id             String @id
  organizationId String
  userId         String
  departmentId   String

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, departmentId])
  @@index([organizationId, departmentId])
  @@map("user_departments")
}

// Interactive sessions. Access is short-lived (JWT); refresh tokens rotate. A
// rotated (reused) refresh token revokes the whole family (suspectedReuse).
model Session {
  id             String    @id
  organizationId String
  userId         String
  familyId       String    @unique
  ip             String?
  userAgent      String?
  lastSeenAt     DateTime  @default(now())
  lastSeenIp     String?
  mfaVerifiedAt  DateTime?
  refreshCount   Int       @default(0)
  suspectedReuse Boolean   @default(false)
  suspendedAt    DateTime?
  revokedAt      DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([organizationId, userId])
  @@index([organizationId, userId, expiresAt])
  @@map("sessions")
}

// Refresh token rows. tokenHash is unique; on use the presented token is either
// the current one (rotate) or a rotated one (reuse → revoke family).
model RefreshToken {
  id             String    @id
  organizationId String
  sessionId      String
  familyId       String
  tokenHash      String    @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  replacedById   String?
  rotatesFromId  String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([organizationId, sessionId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Roles are org data seeded from a default matrix; permissions are granular
// strings from the typed catalog. System roles are protected from edit/delete.
model Role {
  id             String   @id
  organizationId String
  name           String
  key            String
  description    String?
  isSystem       Boolean  @default(false)
  permissions    String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles    UserRole[]

  @@unique([organizationId, key])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model UserRole {
  id             String @id
  organizationId String
  userId         String
  roleId         String

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, roleId])
  @@index([organizationId, roleId])
  @@map("user_roles")
}

// Optional MFA (TOTP). The shared secret is stored AES-256-GCM encrypted;
// recovery codes are stored hashed (SHA-256) and handed out once at enrolment.
model MfaCredential {
  id              String    @id
  organizationId  String
  userId          String    @unique
  secretEncrypted String
  enabledAt       DateTime  @default(now())
  lastVerifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("mfa_credentials")
}

model MfaRecoveryCode {
  id             String    @id
  organizationId String
  userId         String
  codeHash       String    @unique
  usedAt         DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@map("mfa_recovery_codes")
}

// Break-glass / emergency access skeleton (Phase 1). Time-boxed grant with a
// mandatory reason; always audited. Enforcement against resource policies lands
// with the patient module (Phase 2).
model BreakGlassGrant {
  id              String           @id
  organizationId  String
  requesterUserId String
  resourceType    String
  resourceId      String
  reason          String
  status          BreakGlassStatus @default(ACTIVE)
  metadata        Json?

  grantedAt       DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  revokedByUserId String?
  revokeReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requester    User         @relation(fields: [requesterUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, requesterUserId])
  @@map("break_glass_grants")
}

// ---------------------------------------------------------------------------
// Object storage (Phase 2). `Document` is the metadata row for a file stored in
// S3/MinIO. The API never receives the binary; clients upload directly to a
// short-lived presigned PUT URL and confirm via `complete`. Downloads ride the
// presigned GET URL. Storage keys are namespaced per organization so buckets
// never mix tenants.
// ---------------------------------------------------------------------------
enum DocumentStatus {
  PENDING_UPLOAD
  UPLOADED
  DELETED
}

model Document {
  id               String         @id
  organizationId   String
  uploadedByUserId String
  fileName         String
  contentType      String
  sizeBytes        Int?
  checksumSha256   String?
  storageKey       String
  status           DocumentStatus @default(PENDING_UPLOAD)
  metadata         Json?

  uploadedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploadedBy   User         @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, storageKey])
  @@index([organizationId, status, createdAt])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Patients (brief Phase 2). Master patient record, guardians, consents,
// allergies, medical history, access logging and a permission-filtered
// timeline. Patient numbers come from the org-scoped Counter (PAT-YYYY-NNNNNN).
// ---------------------------------------------------------------------------

enum PatientStatus {
  ACTIVE
  MERGED
  ARCHIVED
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum GuardianRelationship {
  PARENT
  SPOUSE
  SIBLING
  RELATIVE
  LEGAL_GUARDIAN
  OTHER
}

enum ConsentType {
  DATA_PROCESSING
  COMMUNICATIONS
  TELEMEDICINE
  DATA_SHARING
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum AllergyStatus {
  ACTIVE
  RESOLVED
  AMENDED
}

enum MedicalHistoryCategory {
  PAST_MEDICAL
  SURGICAL
  FAMILY
  SOCIAL
  PREVIOUS_CONDITIONS
}

enum PatientAccessAction {
  READ
  EXPORT
}

model Patient {
  id             String    @id
  organizationId String
  patientNumber  String
  firstName      String
  lastName       String
  otherNames     String?
  dateOfBirth    DateTime?
  sex            Sex?
  phone          String?
  email          String?
  address        String?
  county         String?
  town           String?
  photoUrl       String?

  // Duplicate handling: set when the creator confirms the record (or a merge
  // reviewer confirms it) is a known duplicate despite a flag. History is kept
  // via audit + timeline; the row itself is never silently deleted.
  duplicateConfirmedAt   DateTime?
  duplicateConfirmedBy   String?
  duplicateConfirmReason String?

  // Reversible-by-design merge: the superseded patient is kept as MEDGED with
  // a pointer to the surviving record instead of being deleted.
  status              PatientStatus @default(ACTIVE)
  mergedIntoPatientId String?
  mergedAt            DateTime?
  mergedReason        String?

  // Optimistic concurrency for record edits.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  guardianLinks        PatientGuardian[]
  consents             PatientConsent[]
  allergies            Allergy[]
  medicalHistory       MedicalHistoryEntry[]
  accessLogs           PatientAccessLog[]
  timeline             PatientTimelineEntry[]
  mergedIntoPatient    Patient?               @relation("PatientMerge", fields: [mergedIntoPatientId], references: [id])
  mergedSourcePatients Patient[]              @relation("PatientMerge")

  appointments     Appointment[]
  waitlistEntries  WaitlistEntry[]
  visits           Visit[]
  queueEntries     QueueEntry[]
  vitalRecords     VitalRecord[]

  @@unique([organizationId, patientNumber])
  @@index([organizationId, lastName, firstName, dateOfBirth])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@map("patients")
}

model Guardian {
  id             String  @id
  organizationId String
  firstName      String
  lastName       String
  phone          String?
  email          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patientLinks PatientGuardian[]

  @@unique([organizationId, phone])
  @@index([organizationId, lastName])
  @@map("guardians")
}

model PatientGuardian {
  id                 String               @id
  organizationId     String
  patientId          String
  guardianId         String
  relationship       GuardianRelationship
  isPrimary          Boolean              @default(false)
  isEmergencyContact Boolean              @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  guardian     Guardian     @relation(fields: [guardianId], references: [id], onDelete: Restrict)

  @@unique([organizationId, patientId, guardianId])
  @@index([organizationId, patientId])
  @@map("patient_guardians")
}

// One consent row per (patient, type); grant/withdraw toggles status. History
// is preserved as timeline entries + audit rows (append-only).
model PatientConsent {
  id               String        @id
  organizationId   String
  patientId        String
  type             ConsentType
  status           ConsentStatus @default(GRANTED)
  grantedAt        DateTime      @default(now())
  withdrawnAt      DateTime?
  notes            String?
  recordedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([organizationId, patientId, type])
  @@index([organizationId, patientId])
  @@map("patient_consents")
}

// Allergies are never silently deleted: amending records a correction (a new
// row whose correctedById points at the superseded one, which flips to AMENDED)
// and resolution flips status to RESOLVED. History is preserved.
model Allergy {
  id               String          @id
  organizationId   String
  patientId        String
  substance        String
  reaction         String?
  severity         AllergySeverity
  status           AllergyStatus   @default(ACTIVE)
  notes            String?
  recordedByUserId String?
  correctedById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([organizationId, patientId])
  @@map("allergies")
}

// Append-only medical history. Corrections are new entries; existing rows are
// never updated or deleted (exposed API provides only create + list).
model MedicalHistoryEntry {
  id               String                 @id
  organizationId   String
  patientId        String
  category         MedicalHistoryCategory
  description      String
  onsetDate        DateTime?
  notes            String?
  recordedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([organizationId, patientId, createdAt])
  @@map("medical_history_entries")
}

// Access log of patient-record reads. Identifiers only, no PHI: who read which
// section of which record when, plus request metadata.
model PatientAccessLog {
  id             String              @id
  organizationId String
  patientId      String
  userId         String?
  action         PatientAccessAction @default(READ)
  section        String
  reason         String?
  ip             String?
  userAgent      String?
  requestId      String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([organizationId, patientId, createdAt])
  @@map("patient_access_logs")
}

// View-projections of the patient timeline. Written in the same transaction as
// the business rows (inline projection until outbox consumers land; see ADR).
// Each entry carries the permission required to read it; reads filter by the
// caller's permission set.
model PatientTimelineEntry {
  id                 String   @id
  organizationId     String
  patientId          String
  type               String
  title              String
  requiredPermission String
  actorId            String?
  payload            Json?
  occurredAt         DateTime @default(now())

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([organizationId, patientId, occurredAt])
  @@map("patient_timeline_entries")
}

// ---------------------------------------------------------------------------
// Scheduling & patient flow (brief Phase 3). Provider schedules and per-day
// overrides feed computed slots; appointments are booked under an advisory
// lock (no double booking); waitlist offers; queue + per-day ticket numbers;
// the visit journey state; append-only vital records; display devices.
// ---------------------------------------------------------------------------

// Single typed settings row per organization (JSON). Read by a typed helper;
// appointments/waitlist only today — extended by later phases.
model OrganizationSetting {
  id             String @id
  organizationId String
  data           Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId])
  @@map("organization_settings")
}

// Recurring weekly availability template for a provider in a branch/department.
// A provider may have several rows per day (morning + evening blocks). Rows
// with isAvailable=false are standing blocked windows (e.g. weekly meetings).
model ProviderSchedule {
  id                 String @id
  organizationId     String
  providerId         String
  branchId           String
  departmentId       String
  // 0=MONDAY .. 6=SUNDAY (matches the domain helper, not JS's getDay()).
  dayOfWeek          Int
  startMinutes       Int
  endMinutes         Int
  slotDurationMinutes Int
  capacity           Int    @default(1)
  isAvailable        Boolean @default(true)
  note               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  provider     User         @relation("ScheduleProvider", fields: [providerId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([organizationId, providerId, dayOfWeek])
  @@index([organizationId, providerId, branchId, departmentId])
  @@map("provider_schedules")
}

// Per-date exceptions. LEAVE/HOLIDAY/BLOCKED make the whole day unavailable
// regardless of the weekly template; WORKING rows replace the template for
// that date with explicit windows.
enum ScheduleOverrideType {
  WORKING
  LEAVE
  HOLIDAY
  BLOCKED
}

model ScheduleOverride {
  id             String              @id
  organizationId String
  providerId     String
  branchId       String
  departmentId   String
  date           DateTime            // business date (UTC midnight)
  type           ScheduleOverrideType
  startMinutes   Int?
  endMinutes     Int?
  slotDurationMinutes Int?
  capacity       Int?
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  provider     User         @relation("ScheduleOverrideProvider", fields: [providerId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([organizationId, providerId, date])
  @@map("schedule_overrides")
}

enum AppointmentMode {
  IN_PERSON
  VIRTUAL
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

// Appointments. No DB unique on (provider, startsAt): capacity-aware booking
// is serialized with a Postgres advisory transaction lock keyed to
// (org, provider, slot start) and then counted under the lock. Free slots are
// computed; bookings never double-allocate the same slot (see domain + tests).
model Appointment {
  id             String            @id
  organizationId String
  branchId       String
  departmentId   String
  patientId      String
  providerId     String
  startsAt       DateTime
  endsAt         DateTime
  mode           AppointmentMode   @default(IN_PERSON)
  appointmentType String?
  reason         String?
  status         AppointmentStatus @default(BOOKED)

  // Optimistic concurrency for reschedules/cancels (delete is never used).
  version Int @default(0)

  createdById  String
  cancelledAt  DateTime?
  cancelReason String?
  cancelledById String?
  noShowAt     DateTime?
  checkedInAt  DateTime?
  inProgressAt DateTime?
  completedAt  DateTime?
  rescheduledToId   String?
  rescheduledFromId String?
  rescheduledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  provider     User         @relation("AppointmentProvider", fields: [providerId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, branchId, startsAt])
  @@index([organizationId, patientId, startsAt])
  @@index([organizationId, providerId, startsAt, status])
  @@map("appointments")
}

enum WaitlistStatus {
  WAITING
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  REMOVED
}

model WaitlistEntry {
  id             String        @id
  organizationId String
  branchId       String
  departmentId   String
  patientId      String
  providerId     String?
  preferredDate  DateTime?
  status         WaitlistStatus @default(WAITING)
  notes          String?

  // Offer details: the concrete slot offered and its expiry. Accept creates an
  // appointment at offeredStartAt; decline/expiry may offer the next entrant.
  offeredAt         DateTime?
  offerExpiresAt    DateTime?
  offeredStartAt    DateTime?
  acceptedAppointmentId String?
  resolvedAt        DateTime?
  resolvedById      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([organizationId, departmentId, status])
  @@index([organizationId, patientId])
  @@map("waitlist_entries")
}

enum VisitSource {
  WALK_IN
  APPOINTMENT
  EMERGENCY
}

// Journey state: the patient's movement through a visit
// (REGISTERED, CHECKED_IN, WAITING, TRIAGE, WAITING_FOR_PROVIDER, CONSULTATION,
//  LAB, RADIOLOGY, PHARMACY, BILLING, COMPLETED). One visit per queue loop.
enum VisitStatus {
  REGISTERED
  CHECKED_IN
  WAITING
  TRIAGE
  WAITING_FOR_PROVIDER
  CONSULTATION
  LAB
  RADIOLOGY
  PHARMACY
  BILLING
  COMPLETED
}

model Visit {
  id             String      @id
  organizationId String
  branchId       String
  departmentId   String
  patientId      String
  appointmentId  String?
  source         VisitSource @default(WALK_IN)
  status         VisitStatus @default(CHECKED_IN)

  // currentQueueEntryId is a plain (non-FK) pointer to the visit's live queue
  // row; it is cleared when the entry completes/leaves.
  currentQueueEntryId String?

  registeredById String?
  registeredAt   DateTime  @default(now())
  checkedInAt    DateTime?
  triageAt       DateTime?
  providerStartedAt DateTime?
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  registeredBy User?        @relation("VisitRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  queueEntries QueueEntry[]

  @@index([organizationId, branchId, status])
  @@index([organizationId, patientId, createdAt])
  @@map("visits")
}

enum OperationalPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum QueueStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  NO_SHOW
  ABANDONED
  CANCELLED
  TRANSFERRED
}

// Queue entry with a per-(branch, department, business-day) ticket number
// (e.g. "A034"). Ticket sequences reset each business day. Timestamps drive
// the queue metrics and estimated-wait calculations.
model QueueEntry {
  id             String             @id
  organizationId String
  branchId       String
  departmentId   String
  visitId        String?
  patientId      String
  queueDate      DateTime           // business date (UTC midnight)
  prefix         String             // ticket letter prefix, e.g. "A"
  ticketNumber   String             // full ticket, e.g. "A034"
  operationalPriority OperationalPriority @default(NORMAL)
  status         QueueStatus        @default(WAITING)

  enteredAt        DateTime  @default(now())
  note             String?
  calledAt         DateTime?
  serviceStartedAt DateTime?
  completedAt      DateTime?
  noShowAt         DateTime?

  calledByUserId  String?
  servedByUserId  String?
  transferredToId   String?
  transferredFromId String?
  transferReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit        Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@unique([organizationId, branchId, departmentId, queueDate, ticketNumber])
  @@index([organizationId, branchId, status, queueDate])
  @@index([organizationId, patientId, queueDate])
  @@map("queue_entries")
}

// Append-only vital observations. Corrections create a NEW record referencing
// the superseded one (correctionOfId); rows are never updated or deleted.
model VitalRecord {
  id               String   @id
  organizationId   String
  branchId         String?
  departmentId     String?
  patientId        String
  visitId          String?

  temperatureC Float?
  systolicMmHg  Int?
  diastolicMmHg Int?
  pulseBpm      Int?
  respiratoryRate Int?
  spo2          Int?
  weightKg      Float?
  heightCm      Float?
  // BMI is always computed in code (domain/bmi.ts) from the same height/weight.
  bmi           Float?
  painScore     Int?
  notes         String?
  observedAt    DateTime

  correctionOfId  String?
  correctionReason String?
  recordedByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  recordedBy   User         @relation("VitalRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, patientId, observedAt])
  @@map("vital_records")
}

enum DisplayDeviceStatus {
  PENDING_PAIRING
  ACTIVE
  REVOKED
}

// Unattended waiting-room display. Pairing swaps a short-lived one-time code
// for a long-lived revocable device token; the token only ever grants
// `queue.display` for its own branch/departments (DeviceAuthGuard).
model DisplayDevice {
  id                String             @id
  organizationId    String
  branchId          String
  name              String
  departmentIds     String[]
  status            DisplayDeviceStatus @default(PENDING_PAIRING)

  pairingCodeHash   String?
  pairingExpiresAt  DateTime?
  tokenHash         String?
  tokenRotatedAt    DateTime?
  lastSeenAt        DateTime?
  createdByUserId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("display_devices")
}
