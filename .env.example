# careOS web environment.
#
# Copy to `.env.local` and adjust. `.env.local` is gitignored; never commit a
# file containing a real secret.
#
# No variable in this file is secret. Anything sensitive lives server-side and is
# proxied through the Next server, so it is never inlined into the client bundle.
# See docs/decisions.md ADR-004.

# Origin the Next server uses to reach the careOS API. Server-side only, so an
# internal cluster address never reaches the browser.
API_INTERNAL_URL=http://localhost:3001

# Path prefix for API calls from the browser. Same-origin by design: this avoids
# CORS entirely and keeps the API host out of the client bundle. The Next server
# proxies this prefix to API_INTERNAL_URL.
NEXT_PUBLIC_API_BASE_PATH=/api/v1

NEXT_PUBLIC_APP_NAME=careOS

# Serve API responses from MSW in the browser. Development and test only — the
# build throws if this is "true" while NODE_ENV=production.
NEXT_PUBLIC_ENABLE_MOCKS=true

# TanStack Query devtools.
NEXT_PUBLIC_ENABLE_QUERY_DEVTOOLS=false
