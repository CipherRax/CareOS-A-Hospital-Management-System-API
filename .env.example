# =========================================================================
# careOS environment configuration (Phase 0)
# Copy to .env and adjust. The app refuses to start on invalid/incomplete config.
# =========================================================================

# --- Node ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
ENABLE_SWAGGER=true

# --- PostgreSQL ---
DATABASE_URL=postgresql://careos:careos@localhost:5432/careos?schema=public
DATABASE_DIRECT_URL=postgresql://careos:careos@localhost:5432/careos?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Queue prefix ---
BULL_PREFIX=careos

# --- MinIO (S3-compatible object storage) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=careos
S3_ACCESS_KEY=careos
S3_SECRET_KEY=careos-minio-key
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900

# --- Logging ---
LOG_LEVEL=info
LOG_REDACT_PATHS=req.headers.authorization,req.headers.cookie,req.body

# --- CORS (comma separated allowlist) ---
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# --- Auth tokens (Phase 1+) ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Issued-at/audience claims; refresh tokens rotate on every use.
JWT_ISSUER=careos
JWT_AUDIENCE=careos-api
JWT_REFRESH_TTL_SECONDS=604800
SESSION_ABS_TTL_SECONDS=2592000

# --- Identity & access (Phase 1) ---
# Key used to encrypt MFA (TOTP) shared secrets at rest. Rotate carefully.
KEY_ENCRYPTION_SECRET=change-me-encryption-secret-at-least-32-chars
MFA_ISSUER=careos
INVITE_TOKEN_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=3600

# --- Prometheus ---
METRICS_ENABLED=true
METRICS_PATH=/metrics

# --- OpenTelemetry (off by default) ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- M-PESA (repo Phase 11) ---
# Provider: 'mock' (default, no network) or 'daraja' (Safaricom adapter; an
# honest non-live stub — see docs/limitations.md).
MPESA_PROVIDER=mock
# Shared secret the STK callback must present via x-careos-mpesa-callback-secret.
MPESA_CALLBACK_SECRET=change-me-mpesa-callback-secret
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# --- Seed guard ---
SEED_ALLOWED=false

# --- Public emergency intake (patch P3/P4) ---
# Retention: anonymize caller PII on terminal requests older than N days
# (0 disables). Duplicate-submission window per normalized caller phone.
# Maintenance sweep period (escalation reconciliation + retention); the sweep
# is not registered under NODE_ENV=test so e2e stays deterministic.
EMERGENCY_RETENTION_DAYS=90
EMERGENCY_DEDUPE_SECONDS=120
EMERGENCY_SWEEP_INTERVAL_MS=60000

# Time-based scheduler (patch P5, ADR-044). Each duty is a BullMQ repeatable job
# on the `scheduler` queue; set SCHEDULER_ENABLED=false for a worker-less deploy
# (e.g. a migration-only run) so no background duty is registered.
SCHEDULER_ENABLED=true
OUTBOX_DRAIN_INTERVAL_MS=5000
MAINTENANCE_REMINDER_INTERVAL_MS=900000
IDEMPOTENCY_SWEEP_INTERVAL_MS=3600000
REPORT_EXPIRY_INTERVAL_MS=300000
SCHEDULER_SWEEP_BATCH=500
SCHEDULER_ORG_BATCH=50

# --- Off-system notification delivery (patch P6, ADR-045) ---
# The notification-delivery sweep attempts PENDING rows whose nextAttemptAt has
# passed, honouring recipient opt-outs first. Retries back off from the base
# below until NOTIFICATION_DELIVERY_MAX_ATTEMPTS, then the row is FAILED.
NOTIFICATION_DELIVERY_INTERVAL_MS=15000
NOTIFICATION_DELIVERY_BATCH=100
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=5
NOTIFICATION_DELIVERY_RETRY_BASE_MS=30000
# Channels the consumer fans out to on top of IN_APP. Empty = in-app only,
# which is the safe default (an off-system send cannot be unsent). Recipients
# can still opt out per channel/category via PUT /notifications/preferences.
NOTIFICATION_OFFSITE_CHANNELS=
# Delivery adapter. Unset = structural stub (nothing leaves the host). Set =
# EMAIL/SMS/PUSH are POSTed as an HMAC-signed JSON webhook to this URL, with
# the notification id as an idempotency key for receiver-side dedupe.
NOTIFICATION_WEBHOOK_URL=
# HMAC-SHA256 key for the webhook body signature (x-careos-signature).
NOTIFICATION_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_TIMEOUT_MS=10000