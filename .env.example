# =========================================================================
# careOS environment configuration (Phase 0)
# Copy to .env and adjust. The app refuses to start on invalid/incomplete config.
# =========================================================================

# --- Node ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
ENABLE_SWAGGER=true

# --- PostgreSQL ---
DATABASE_URL=postgresql://careos:careos@localhost:5432/careos?schema=public
DATABASE_DIRECT_URL=postgresql://careos:careos@localhost:5432/careos?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Queue prefix ---
BULL_PREFIX=careos

# --- MinIO (S3-compatible object storage) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=careos
S3_ACCESS_KEY=careos
S3_SECRET_KEY=careos-minio-key
S3_FORCE_PATH_STYLE=true

# --- Logging ---
LOG_LEVEL=info
LOG_REDACT_PATHS=req.headers.authorization,req.headers.cookie,req.body

# --- CORS (comma separated allowlist) ---
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# --- Auth tokens (Phase 1+) ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Issued-at/audience claims; refresh tokens rotate on every use.
JWT_ISSUER=careos
JWT_AUDIENCE=careos-api
JWT_REFRESH_TTL_SECONDS=604800
SESSION_ABS_TTL_SECONDS=2592000

# --- Identity & access (Phase 1) ---
# Key used to encrypt MFA (TOTP) shared secrets at rest. Rotate carefully.
KEY_ENCRYPTION_SECRET=change-me-encryption-secret-at-least-32-chars
MFA_ISSUER=careos
INVITE_TOKEN_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=3600

# --- Prometheus ---
METRICS_ENABLED=true
METRICS_PATH=/metrics

# --- OpenTelemetry (off by default) ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Seed guard ---
SEED_ALLOWED=false