{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "openapi": "3.1.0",
  "info": {
    "title": "careOS API (frontend contract subset)",
    "version": "0.1.0-f0-partial",
    "description": "PARTIAL, HAND-AUTHORED contract. The careOS API generates its OpenAPI document at runtime via NestJS Swagger and does not check one in, and the full document cannot be exported without a live Postgres and Redis. This file covers only what Phase F0 needs: the response envelope, the error shape, the public configuration and facility endpoints, emergency intake submission, and /auth/me. Every endpoint not listed here is an unmapped gap recorded in docs/api-contract-gaps.md. Regenerate types with `npm run api:types`."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Same-origin. The browser never talks to the API host directly; the Next server proxies this prefix to API_INTERNAL_URL."
    }
  ],
  "tags": [
    { "name": "public", "description": "Unauthenticated, patient-facing." },
    { "name": "auth", "description": "Session and identity." }
  ],
  "paths": {
    "/public/config": {
      "get": {
        "tags": ["public"],
        "operationId": "getPublicConfig",
        "summary": "Platform configuration for the unauthenticated surface.",
        "responses": {
          "200": {
            "description": "Configuration",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/PublicConfig" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/public/facilities": {
      "get": {
        "tags": ["public"],
        "operationId": "listPublicFacilities",
        "summary": "Published facilities. Unauthenticated; only fields marked public are returned.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Free-text search over name and address."
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/FacilityType" }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching facilities",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "items": {
                              "type": "array",
                              "items": { "$ref": "#/components/schemas/PublicFacility" }
                            },
                            "total": { "type": "integer" }
                          },
                          "required": ["items", "total"]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/public/emergency-requests": {
      "post": {
        "tags": ["public"],
        "operationId": "submitEmergencyRequest",
        "summary": "Submit an emergency intake request.",
        "description": "Rate limited. The caller receives a reference to track with, not a clinical assessment. The UI must not present a response as triage.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EmergencyRequestInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Request accepted",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/EmergencyRequestReceipt" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["auth"],
        "operationId": "getCurrentUser",
        "summary": "Current session identity and role grants.",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/CurrentUser" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "careos_session",
        "description": "Opaque session identifier. The browser must never be able to read or forge this; the API sets it HttpOnly."
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Request failed validation",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
            "examples": {
              "validation": {
                "value": {
                  "success": false,
                  "error": { "code": "VALIDATION_ERROR", "message": "phone is required" },
                  "meta": { "requestId": "req_01" }
                }
              }
            }
          }
        }
      },
      "Unauthenticated": {
        "description": "No valid session",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Upstream dependency unavailable",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected server error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      }
    },
    "schemas": {
      "Meta": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["requestId"]
      },
      "SuccessEnvelope": {
        "type": "object",
        "properties": {
          "success": { "const": true },
          "data": {},
          "meta": { "$ref": "#/components/schemas/Meta" }
        },
        "required": ["success", "data"]
      },
      "ApiErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine code. The UI maps this through src/lib/errors/catalog.ts and never renders `message` directly.",
            "enum": [
              "VALIDATION_ERROR",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "UNPROCESSABLE_ENTITY",
              "RATE_LIMITED",
              "INTERNAL_ERROR",
              "SERVICE_UNAVAILABLE"
            ]
          },
          "message": { "type": "string", "description": "Diagnostic detail. Not for display." },
          "details": { "type": "array", "items": { "type": "object" } }
        },
        "required": ["code", "message"]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "success": { "const": false },
          "error": { "$ref": "#/components/schemas/ApiErrorBody" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        },
        "required": ["success", "error"]
      },
      "FacilityType": {
        "type": "string",
        "enum": ["GENERAL", "REFERRAL", "SPECIALIST", "CLINIC", "PRIMARY_CARE"]
      },
      "PublicConfig": {
        "type": "object",
        "properties": {
          "platformName": { "type": "string" },
          "defaultLocale": { "type": "string" },
          "supportedLocales": { "type": "array", "items": { "type": "string" } },
          "features": {
            "type": "object",
            "properties": {
              "emergencyIntake": { "type": "boolean" },
              "displayScreens": { "type": "boolean" },
              "patientPortal": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "required": ["platformName", "defaultLocale", "supportedLocales"]
      },
      "PublicFacility": {
        "type": "object",
        "description": "Only publishable fields. Internal notes, staffing and billing data must never appear here.",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "shortName": { "type": ["string", "null"] },
          "type": { "$ref": "#/components/schemas/FacilityType" },
          "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
          "phone": { "type": ["string", "null"] },
          "emergencyPhone": { "type": ["string", "null"] },
          "address": { "type": ["string", "null"] }
        },
        "required": ["id", "name", "type", "status"]
      },
      "EmergencyRequestInput": {
        "type": "object",
        "properties": {
          "facilityId": { "type": "string" },
          "patientName": { "type": "string" },
          "phone": { "type": "string" },
          "description": { "type": "string" },
          "consentToContact": { "const": true }
        },
        "required": ["facilityId", "patientName", "phone", "description", "consentToContact"]
      },
      "EmergencyRequestReceipt": {
        "type": "object",
        "description": "A tracking receipt. Deliberately carries no clinical assessment: intake must not imply triage.",
        "properties": {
          "id": { "type": "string" },
          "reference": { "type": "string" },
          "status": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "reference", "status", "createdAt"]
      },
      "RoleGrant": {
        "type": "object",
        "properties": {
          "role": { "type": "string" },
          "facilityId": { "type": ["string", "null"] },
          "facilityName": { "type": ["string", "null"] },
          "scope": { "type": "string" }
        },
        "required": ["role", "scope"]
      },
      "BreakGlassGrant": {
        "type": "object",
        "properties": {
          "facilityId": { "type": ["string", "null"] },
          "grantedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": ["string", "null"], "format": "date-time" },
          "reason": { "type": ["string", "null"] }
        },
        "required": ["grantedAt"]
      },
      "CurrentUser": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "displayName": { "type": ["string", "null"] },
          "user": {
            "type": "object",
            "description": "The API returns the user twice: a top-level identity for the session, and a nested `user` object carrying `roles` as grant objects. Both shapes are asserted against the backend in Phase 12; see docs/api-contract-gaps.md GAP-004.",
            "properties": {
              "id": { "type": "string" },
              "email": { "type": "string", "format": "email" },
              "displayName": { "type": ["string", "null"] },
              "roles": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/RoleGrant" }
              }
            },
            "required": ["id", "email", "roles"]
          },
          "roles": {
            "type": "array",
            "description": "Legacy flat string list, retained additively for compatibility. Prefer `user.roles`.",
            "items": { "type": "string" }
          },
          "breakGlass": {
            "type": ["object", "null"],
            "description": "Legacy single break-glass object, retained additively. Prefer `breakGlassGrants`.",
            "additionalProperties": true
          },
          "breakGlassGrants": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BreakGlassGrant" }
          }
        },
        "required": ["id", "email", "user", "roles"]
      }
    }
  }
}
